---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
// Preload the two above-the-fold fonts (hashed URLs via Vite).
import interRegularWoff2 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import interSemiboldWoff2 from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import NetworkBackground from '../components/NetworkBackground.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  titleKey?: string;
  descriptionKey?: string;
}

const {
  title,
  description = "Filippo Lollato, MSc student in Artificial Intelligence Systems at the University of Trento, engineering intelligent AI systems and production service integrations.",
  ogImage = "/og.png",
  titleKey,
  descriptionKey,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://filippolollato.dev");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Filippo Lollato",
  url: siteUrl.href,
  email: "mailto:contact@lollato.dev",
  jobTitle: "MSc Student in Artificial Intelligence Systems",
  affiliation: { "@type": "CollegeOrUniversity", name: "University of Trento" },
  sameAs: ["https://github.com/xupremix"],
  knowsAbout: ["Machine Learning", "Rust", "Multi-agent systems", "Computer Vision", "NLP"],
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Primary SEO -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1e1e2e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/woff2" href={interRegularWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interSemiboldWoff2} crossorigin />

    <!-- Primary SEO -->
    <title data-i18n={titleKey}>{title}</title>
    <meta name="description" content={description} data-i18n-content={descriptionKey} />
    <meta name="author" content="Filippo Lollato" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} data-i18n-content={titleKey} />
    <meta property="og:description" content={description} data-i18n-content={descriptionKey} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Filippo Lollato" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} data-i18n-content={titleKey} />
    <meta name="twitter:description" content={description} data-i18n-content={descriptionKey} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />

    <script type="application/ld+json" set:html={personJsonLd} />

    <!-- Plausible: cookieless, privacy-friendly page analytics -->
    <script defer data-domain="filippolollato.dev" src="https://plausible.io/js/script.js"></script>
  </head>
  <body class="bg-base text-text font-sans">
    <NetworkBackground />
    <Nav />
    <slot />
    <Footer />

    <script>
      import { translations, type Language } from '../i18n';

      const languageToggle = document.querySelector<HTMLButtonElement>('#language-toggle');

      function setLanguage(language: Language) {
        document.documentElement.lang = language;
        localStorage.setItem('portfolio-language', language);
        document.querySelector<HTMLMetaElement>('meta[property="og:locale"]')?.setAttribute('content', language === 'en' ? 'en_US' : 'it_IT');

        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((element) => {
          const key = element.dataset.i18n;
          const translation = key ? translations[key]?.[language] : undefined;
          if (translation !== undefined) element.textContent = translation;
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach((element) => {
          const key = element.dataset.i18nHtml;
          const translation = key ? translations[key]?.[language] : undefined;
          if (translation !== undefined) element.innerHTML = translation;
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((element) => {
          const key = element.dataset.i18nAria;
          const translation = key ? translations[key]?.[language] : undefined;
          if (translation !== undefined) element.setAttribute('aria-label', translation);
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-title]').forEach((element) => {
          const key = element.dataset.i18nTitle;
          const translation = key ? translations[key]?.[language] : undefined;
          if (translation !== undefined) element.title = translation;
        });

        document.querySelectorAll<HTMLMetaElement>('[data-i18n-content]').forEach((element) => {
          const key = element.dataset.i18nContent;
          const translation = key ? translations[key]?.[language] : undefined;
          if (translation !== undefined) element.content = translation;
        });

        if (languageToggle) {
          languageToggle.textContent = language === 'en' ? 'IT' : 'EN';
          languageToggle.setAttribute('aria-label', language === 'en' ? 'Switch language to Italian' : 'Passa alla lingua inglese');
          languageToggle.title = language === 'en' ? 'Switch language to Italian' : 'Passa alla lingua inglese';
          languageToggle.setAttribute('aria-pressed', String(language === 'it'));
        }
      }

      const savedLanguage = localStorage.getItem('portfolio-language') === 'it' ? 'it' : 'en';
      setLanguage(savedLanguage);
      languageToggle?.addEventListener('click', () => {
        setLanguage(document.documentElement.lang === 'en' ? 'it' : 'en');
      });

      // ── Scroll Reveal ──────────────────────────────────────
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));

      // Dialog behavior (backdrop close, scroll lock/unlock) lives in
      // src/components/DemoDialog.astro: do not duplicate it here.

      // ── Network Background Triggers ─────────────────────────
      // Send mouse coordinates to the NetworkBackground canvas when hovering
      // interactive elements to trigger the "forward pass" wave.
      document.querySelectorAll('a, button, .interactive-trigger').forEach((el) => {
        el.addEventListener('mouseenter', (e) => {
          const ev = e as MouseEvent;
          window.dispatchEvent(new CustomEvent('trigger-forward-pass', {
            detail: { x: ev.clientX, y: ev.clientY }
          }));
        });
      });
    </script>
  </body>
</html>
