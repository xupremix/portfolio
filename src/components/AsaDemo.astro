---
// ASA Autobots demo: animated pipeline walkthrough (real vocabulary/PDDL,
// labeled illustrative). All logic in src/scripts/asa-demo.ts.
import DemoDialog from './DemoDialog.astro';
import { Icon } from 'astro-icon/components';

const steps = [
  'STRIPS PDDL path plan',
  'LLM coordinator assigns task',
  'BDI executor → pickup',
  'BDI executor → deliver',
  'Delivered · back to idle',
];
---

<DemoDialog
  id="asa-demo"
  title="ASA Autobots: Multi-Agent Delivery"
  subtitle="BDI Physical Executor · LLM Cognitive Coordinator (llama-3.3-70b) · STRIPS PDDL - built with a teammate"
>
  <div slot="main" class="flex min-h-0 flex-1 flex-col items-center justify-center gap-md p-md">
    <!-- Interactive Placement Tools -->
    <div class="flex flex-wrap items-center justify-center gap-xs">
      <span class="font-mono text-[11px] text-subtext mr-1">click grid to place:</span>
      <div role="tablist" class="flex overflow-hidden rounded-[var(--radius-control)] border border-border">
        <button
          type="button"
          id="asa-tool-parcel"
          class="asa-tool-btn cursor-pointer bg-accent/15 px-md py-1 font-mono text-[12px] font-bold text-accent transition-colors"
        >
          <Icon name="lucide:package" class="inline mr-1" width={13} height={13} /> Parcel
        </button>
        <button
          type="button"
          id="asa-tool-delivery"
          class="asa-tool-btn cursor-pointer border-l border-border px-md py-1 font-mono text-[12px] font-bold text-subtext transition-colors"
        >
          <Icon name="lucide:target" class="inline mr-1" width={13} height={13} /> Goal
        </button>
      </div>
    </div>

    <div class="w-full max-w-[520px] relative">
      <canvas id="asa-canvas" class="w-full rounded-[var(--radius-control)] border border-border cursor-pointer"></canvas>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-sm">
      <button
        id="asa-play-pause"
        type="button"
        class="inline-flex cursor-pointer items-center gap-xs rounded-[var(--radius-control)] bg-accent px-md py-xs text-[13px] font-bold text-base transition-opacity hover:opacity-90 focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
      >
        <span id="asa-icon-pause"><Icon name="lucide:pause" width={13} height={13} aria-hidden="true" /></span>
        <span id="asa-icon-play" class="hidden"><Icon name="lucide:play" width={13} height={13} aria-hidden="true" /></span>
        <span id="asa-play-label">Pause</span>
      </button>
      <button
        id="asa-restart"
        type="button"
        class="inline-flex cursor-pointer items-center gap-xs rounded-[var(--radius-control)] border border-border px-md py-xs text-[13px] font-semibold text-subtext transition-colors hover:border-accent/40 hover:text-accent focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
      >
        <Icon name="lucide:rotate-ccw" width={13} height={13} aria-hidden="true" />
        Restart
      </button>
    </div>
    <p class="text-center text-[11px] text-subtext">
      Click any tile on the 8×7 grid to relocate the parcel or delivery target. The STRIPS planner re-solves the route instantly.
    </p>
  </div>

  <div slot="aside">
    <!-- Pipeline stepper -->
    <div>
      <div class="demo-kicker mb-sm">pipeline</div>
      <ol class="flex flex-col gap-sm">
        {steps.map((label, i) => (
          <li data-asa-step={i} class="flex items-center gap-sm text-[13px] text-subtext">
            <span class="inline-block h-2.5 w-2.5 shrink-0 rounded-full border border-border"></span>
            {label}
          </li>
        ))}
      </ol>
      <div
        id="asa-action-log"
        class="mt-sm min-h-[40px] rounded-[var(--radius-control)] bg-base p-sm font-mono text-[11px] leading-relaxed text-text"
      ></div>
    </div>

    <!-- Live PDDL Action Plan -->
    <div>
      <div class="demo-kicker mb-xs">generated PDDL actions</div>
      <div
        id="asa-pddl-plan-list"
        class="max-h-[140px] overflow-y-auto rounded-[var(--radius-control)] border border-border bg-base p-xs font-mono text-[10.5px] leading-snug text-subtext flex flex-col gap-0.5"
      ></div>
    </div>

    <!-- Legend -->
    <div>
      <div class="demo-kicker mb-sm">legend</div>
      <ul class="flex flex-col gap-xs text-[12px] text-text">
        <li class="flex items-center gap-sm"><span class="inline-block h-3 w-3 rounded-[3px] bg-accent"></span>BDI agent</li>
        <li class="flex items-center gap-sm"><Icon name="lucide:package" class="text-subtext inline mr-1" width={14} height={14} /> Parcel (spawn tile)</li>
        <li class="flex items-center gap-sm"><Icon name="lucide:target" class="text-subtext inline mr-1" width={14} height={14} /> Delivery zone</li>
        <li class="flex items-center gap-sm"><span class="inline-block h-0.5 w-4 border-t-2 border-dashed border-accent"></span>planned PDDL route</li>
      </ul>
    </div>

    <!-- Who built what -->
    <div class="flex flex-col gap-sm text-[12px] leading-relaxed">
      <div class="demo-kicker">architecture & credit</div>
      <div class="border-l-2 border-accent pl-sm">
        <strong class="text-accent">My role:</strong>
        <span class="text-text">BDI executor, PDDL planning integration, belief base design. Led architecture decisions.</span>
      </div>
      <div class="border-l-2 border-border pl-sm">
        <strong class="text-text">Teammate:</strong>
        <span class="text-text">LLM coordination layer and the agent message-passing protocol.</span>
      </div>
      <div class="border-l-2 border-green pl-sm">
        <strong class="text-green">Result:</strong>
        <span class="text-text">~91.5% test coverage, 3-layer agent architecture running in real time.</span>
      </div>
    </div>
  </div>
</DemoDialog>

<script>
  import { initAsaDemo } from '../scripts/asa-demo';
  initAsaDemo();
</script>
