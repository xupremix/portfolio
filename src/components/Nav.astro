---
// Sticky nav: terminal-style brand mark, section links with active-section
// highlight, scroll progress bar, compact scrolled state, CSS-checkbox mobile
// menu that closes itself when a link is tapped.
import { Icon } from 'astro-icon/components';

// Absolute /# anchors so the nav also works from /404 and any future page.
const links = [
  { href: '/#projects', label: 'Projects' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#experience', label: 'Experience' },
];

const linkClass =
  'nav-link text-label text-text hover:text-accent focus-visible:text-accent focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none transition-colors';
---

<header
  id="site-nav"
  class="sticky top-0 z-50 h-3xl border-b border-border/50 bg-mantle/10 backdrop-blur-md transition-[height,background-color,box-shadow] duration-300"
>
  <div class="relative flex h-full items-center justify-between px-lg md:px-xl">
    <a
      href="/"
      class="font-mono text-label font-semibold text-text focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
    >
      <span class="text-accent">~/</span>filippo-lollato
    </a>

    <nav class="hidden items-center gap-lg md:flex" aria-label="Site sections">
      {links.map((link) => <a href={link.href} class={linkClass}>{link.label}</a>)}
      <a
        href="/#contact"
        class="nav-link rounded-[var(--radius-control)] bg-accent px-md py-xs text-label font-semibold text-base focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
      >
        Contact
      </a>
      <button
        type="button"
        data-mode-toggle
        aria-label="Switch design theme"
        title="Switch design theme"
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-[var(--radius-control)] border border-border text-subtext transition-colors hover:border-accent/40 hover:text-accent focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
      >
        <span data-mode-icon="ink"><Icon name="lucide:leaf" width={16} height={16} aria-hidden="true" /></span>
        <span data-mode-icon="paper" class="hidden"><Icon name="lucide:terminal" width={16} height={16} aria-hidden="true" /></span>
      </button>
    </nav>

    <!-- Mobile: mode toggle sits beside the hamburger -->
    <div class="ml-auto mr-xs flex items-center md:hidden">
      <button
        type="button"
        data-mode-toggle
        aria-label="Switch design theme"
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-[var(--radius-control)] border border-border text-subtext focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
      >
        <span data-mode-icon="ink"><Icon name="lucide:leaf" width={16} height={16} aria-hidden="true" /></span>
        <span data-mode-icon="paper" class="hidden"><Icon name="lucide:terminal" width={16} height={16} aria-hidden="true" /></span>
      </button>
    </div>

    <input type="checkbox" id="nav-toggle" class="peer sr-only" />
    <label
      for="nav-toggle"
      id="nav-toggle-open"
      tabindex="0"
      role="button"
      class="flex h-11 w-11 items-center justify-center peer-checked:hidden focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none md:hidden"
    >
      <Icon name="lucide:menu" width={24} height={24} />
      <span class="sr-only">Open menu</span>
    </label>
    <label
      for="nav-toggle"
      id="nav-toggle-close"
      tabindex="0"
      role="button"
      class="hidden h-11 w-11 items-center justify-center peer-checked:flex focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none md:hidden"
    >
      <Icon name="lucide:x" width={24} height={24} />
      <span class="sr-only">Close menu</span>
    </label>

    <nav
      class="absolute inset-x-0 top-full hidden flex-col gap-md border-b border-border bg-mantle p-lg peer-checked:flex md:hidden"
      aria-label="Site sections"
    >
      {links.map((link) => <a href={link.href} class={linkClass}>{link.label}</a>)}
      <a
        href="/#contact"
        class="nav-link rounded-[var(--radius-control)] bg-accent px-md py-xs text-center text-label font-semibold text-base focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
      >
        Contact
      </a>
    </nav>
  </div>

  <!-- Scroll progress -->
  <div
    id="nav-progress"
    aria-hidden="true"
    class="absolute bottom-0 left-0 h-[2px] w-full origin-left scale-x-0 bg-accent will-change-transform"
  ></div>
</header>

<style>
  #site-nav.is-scrolled {
    height: 56px;
    background-color: var(--color-mantle);
    backdrop-filter: none;
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.25);
  }
  .nav-link[aria-current='true'] {
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    #site-nav { transition: none; }
  }
</style>

<script>
  const nav = document.querySelector('#site-nav');
  const progress = document.querySelector<HTMLElement>('#nav-progress');

  function onScroll() {
    if (!nav) return;
    nav.classList.toggle('is-scrolled', window.scrollY > 0);
    if (progress) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? window.scrollY / max : 0;
      progress.style.transform = `scaleX(${Math.min(Math.max(p, 0), 1)})`;
    }
  }
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Keyboard support for the checkbox-based mobile toggle
  const navToggle = document.querySelector<HTMLInputElement>('#nav-toggle');
  function handleToggleKeydown(event: KeyboardEvent) {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      if (navToggle) navToggle.checked = !navToggle.checked;
    }
  }
  document.querySelector('#nav-toggle-open')?.addEventListener('keydown', handleToggleKeydown);
  document.querySelector('#nav-toggle-close')?.addEventListener('keydown', handleToggleKeydown);

  // Close the mobile menu when any nav link is tapped
  document.querySelectorAll('#site-nav nav a').forEach((a) => {
    a.addEventListener('click', () => {
      if (navToggle) navToggle.checked = false;
    });
  });

  // ── Design-mode toggle (ink ↔ paper) ─────────────────────
  const THEME_COLORS: Record<string, string> = { ink: '#1e1e2e', paper: '#f4efe4' };

  function applyModeUi() {
    const mode = document.documentElement.dataset.mode === 'paper' ? 'paper' : 'ink';
    document.querySelectorAll<HTMLElement>('[data-mode-icon]').forEach((icon) => {
      icon.classList.toggle('hidden', icon.dataset.modeIcon !== mode);
    });
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', THEME_COLORS[mode]);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-mode-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.mode === 'paper' ? 'ink' : 'paper';
      if (next === 'paper') {
        document.documentElement.dataset.mode = 'paper';
      } else {
        delete document.documentElement.dataset.mode;
      }
      localStorage.setItem('design-mode', next);
      applyModeUi();
    });
  });
  applyModeUi();

  // Active-section highlight: watch the four section anchors
  const sectionIds = ['projects', 'skills', 'experience', 'contact'];
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = `#${entry.target.id}`;
        document.querySelectorAll('.nav-link').forEach((link) => {
          link.setAttribute('aria-current', String((link.getAttribute('href') ?? '').endsWith(id)));
        });
      });
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  sectionIds.forEach((id) => {
    const section = document.getElementById(id);
    if (section) sectionObserver.observe(section);
  });
</script>
