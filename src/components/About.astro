---
// Three working-principles pillars. Metric fragments are wrapped in mono
// accent spans via set:html (static, author-controlled strings only).
import { Icon } from 'astro-icon/components';

const metric = (s: string) => `<span class="font-mono font-semibold text-accent">${s}</span>`;

const pillars = [
  {
    icon: 'lucide:layers',
    heading: 'Strong Foundations',
    body: `I prioritize a deep understanding of the systems I build. For example, incin checks ML tensor invariants at compile time, and the ASA agent coordinates live deliveries.`,
  },
  {
    icon: 'lucide:users',
    heading: 'Team Collaboration',
    body: `I am an effective team player. The ASA Autobots project was built jointly with a teammate, achieving ${metric('~91.5%')} test coverage through shared design decisions.`,
  },
  {
    icon: 'lucide:zap',
    heading: 'Results-Oriented',
    body: `I focus on practical outcomes. My projects aim for tangible improvements, such as reducing RMSE in object tracking and achieving ${metric('0.9765')} intent accuracy in NLU tasks.`,
  },
];
---

<section aria-labelledby="about-heading" class="border-y border-border/40 bg-mantle/30 px-lg py-2xl md:px-xl">
  <h2 id="about-heading" class="sr-only">How I work</h2>
  <div class="mx-auto grid max-w-[72rem] grid-cols-1 gap-lg md:grid-cols-3">
    {pillars.map((pillar, i) => (
      <div class="reveal group grid grid-cols-[40px_1fr] gap-x-sm gap-y-sm" data-delay={String(i + 1)}>
        <div class="flex h-10 w-10 items-center justify-center rounded-[var(--radius-control)] bg-accent/10 text-accent transition-colors duration-200 group-hover:bg-accent group-hover:text-base">
          <Icon name={pillar.icon} width={20} height={20} aria-hidden="true" />
        </div>
        <h3 class="self-center text-label font-semibold text-text">{pillar.heading}</h3>
        <p class="col-start-2 text-body text-subtext"><Fragment set:html={pillar.body} /></p>
      </div>
    ))}
  </div>
</section>
