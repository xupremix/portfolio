// Short introduction to current focus, project experience, and engineering approach.
---
import { Icon } from 'astro-icon/components';

const pillars = [
  {
    icon: 'lucide:brain',
    number: '01',
    title: 'Model optimization',
    titleKey: 'about.model.title',
    body: "I'm developing my skills in fine-tuning, distillation, and quantization through my MSc work.",
    bodyKey: 'about.model.body',
    tone: 'about-tone-violet',
  },
  {
    icon: 'lucide:workflow',
    number: '02',
    title: 'Multi-agent systems',
    titleKey: 'about.systems.title',
    body: 'In ASA Autobots, I worked on the system architecture connecting an LLM coordinator, BDI agents, and PDDL planning.',
    bodyKey: 'about.systems.body',
    tone: 'about-tone-blue',
  },
  {
    icon: 'lucide:blocks',
    number: '03',
    title: 'AI software engineering',
    titleKey: 'about.engineering.title',
    body: "I'm interested in building up my experience with the APIs, backends, and integrations around AI models.",
    bodyKey: 'about.engineering.body',
    tone: 'about-tone-green',
  },
];
---

<section aria-labelledby="about-heading" class="border-y border-border/40 bg-mantle/25 px-lg py-3xl md:px-xl">
  <div class="mx-auto max-w-[72rem]">
    <div class="reveal mb-xl">
      <p class="section-eyebrow" data-i18n="about.eyebrow">current focus</p>
      <h2 id="about-heading" class="gradient-text mt-sm inline-block text-display font-semibold" data-i18n="about.title">
        What I'm working on
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-md md:grid-cols-3">
      {pillars.map((pillar, i) => (
        <article class="about-card reveal relative flex flex-col gap-md overflow-hidden rounded-[var(--radius-card)] border border-border/70 bg-mantle/75 p-lg" data-delay={String(i + 1)}>
          <div class="flex items-center justify-between">
            <span class:list={['about-icon flex h-10 w-10 items-center justify-center rounded-[var(--radius-control)]', pillar.tone]}>
              <Icon name={pillar.icon} width={19} height={19} aria-hidden="true" />
            </span>
            <span class="font-mono text-xs text-subtext/60">{pillar.number}</span>
          </div>
          <div>
            <h3 class="text-title font-semibold text-text" data-i18n={pillar.titleKey}>{pillar.title}</h3>
            <p class="mt-sm text-body leading-relaxed text-subtext" data-i18n={pillar.bodyKey}>{pillar.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .about-card {
    background-image: linear-gradient(145deg, rgb(203 166 247 / 0.035), transparent 55%);
    transition: border-color 220ms ease, background-color 220ms ease, transform 220ms ease;
  }

  .about-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent) 32%, var(--color-border));
    background-color: color-mix(in srgb, var(--color-mantle) 88%, var(--color-accent));
  }

  .about-tone-violet { background: rgb(203 166 247 / 0.1); color: #d8b4fe; }
  .about-tone-blue { background: rgb(137 180 250 / 0.1); color: #a9d8f5; }
  .about-tone-green { background: rgb(166 227 161 / 0.1); color: #a7e8cf; }

  @media (prefers-reduced-motion: reduce) {
    .about-card { transition: none; }
    .about-card:hover { transform: none; }
  }
</style>
