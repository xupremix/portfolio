---
import { Icon } from 'astro-icon/components';

const pillars = [
  {
    icon: "lucide:layers",
    heading: "Creative Problem Solving",
    body: "I enjoy tackling complex problems by building robust systems from the ground up, whether it's exploring compile-time safety or designing multi-agent architectures.",
  },
  {
    icon: "lucide:users",
    heading: "Collaborative Teamwork",
    body: "I strongly believe in the power of collaboration. Co-leading the ASA Autobots project allowed me to work closely with a teammate to design a comprehensive system together.",
  },
  {
    icon: "lucide:zap",
    heading: "Impactful Decisions",
    body: "I try to focus on measurable results and practical applications. Whether it's reducing tracking error on KITTI or achieving high accuracy in NLU tasks, I want my work to have a tangible impact.",
  },
];
---

<section class="py-2xl px-lg md:px-xl border-y border-border/40 bg-mantle/30">
  <div class="max-w-[72rem] mx-auto grid grid-cols-1 md:grid-cols-3 gap-lg">
    {pillars.map((p, i) => (
      <div class="reveal flex flex-col gap-sm" data-delay={String(i + 1)}>
        <div class="flex items-center gap-sm">
          <div class="flex items-center justify-center w-10 h-10 rounded-md bg-accent/10 text-accent shrink-0">
            <Icon name={p.icon} width={20} height={20} aria-hidden="true" />
          </div>
          <h2 class="text-label font-semibold text-text">{p.heading}</h2>
        </div>
        <p class="text-body text-subtext pl-[52px]">{p.body}</p>
      </div>
    ))}
  </div>

  <div class="max-w-[72rem] mx-auto mt-2xl flex justify-center reveal" data-delay="4">
    <a
      href="/cv.pdf"
      target="_blank"
      class="inline-flex items-center gap-sm border border-border rounded-md px-md py-sm text-label font-semibold text-text hover:text-accent hover:border-accent/40 focus-visible:text-accent focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none transition-colors"
    >
      <Icon name="lucide:file-text" width={16} height={16} aria-hidden="true" />
      Download CV
    </a>
  </div>
</section>
