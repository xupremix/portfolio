---
// signal_image_video demo — live tracking simulation with honestly computed
// RMSE. All logic in src/scripts/signal-demo.ts.
import DemoDialog from './DemoDialog.astro';
import { Icon } from 'astro-icon/components';
---

<DemoDialog
  id="signal-demo"
  title="signal_image_video — multi-object tracking"
  subtitle="Constant-velocity Kalman vs CTRV-EKF prediction, simulated live in your browser"
>
  <div slot="main" class="flex min-h-0 flex-1 flex-col items-center justify-center gap-md p-md">
    <!-- Predictor toggle -->
    <div role="tablist" class="flex overflow-hidden rounded-[var(--radius-control)] border border-border">
      <button
        type="button"
        role="tab"
        data-mode="linear"
        aria-selected="true"
        class="signal-mode-btn cursor-pointer bg-accent/15 px-lg py-xs font-mono text-[12px] font-bold text-accent transition-colors"
      >
        Linear KF
      </button>
      <button
        type="button"
        role="tab"
        data-mode="ctrv"
        aria-selected="false"
        class="signal-mode-btn cursor-pointer border-l border-border px-lg py-xs font-mono text-[12px] font-bold text-subtext transition-colors"
      >
        CTRV-EKF
      </button>
    </div>

    <div class="w-full max-w-[540px]">
      <canvas id="signal-canvas" class="w-full rounded-[var(--radius-control)] border border-border"></canvas>
    </div>

    <button
      id="signal-play-pause"
      type="button"
      class="inline-flex cursor-pointer items-center gap-xs rounded-[var(--radius-control)] bg-accent px-md py-xs text-[13px] font-bold text-base transition-opacity hover:opacity-90 focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
    >
      <span id="signal-icon-pause"><Icon name="lucide:pause" width={13} height={13} aria-hidden="true" /></span>
      <span id="signal-icon-play" class="hidden"><Icon name="lucide:play" width={13} height={13} aria-hidden="true" /></span>
      <span id="signal-play-label">Pause</span>
    </button>
  </div>

  <div slot="aside">
    <!-- Live metric: computed from the on-screen gap, never canned -->
    <div>
      <div class="demo-kicker mb-sm">RMSE — this simulation</div>
      <div class="flex items-baseline gap-sm">
        <span id="signal-rmse" class="font-mono text-[32px] leading-none font-semibold text-text">—</span>
        <span class="font-mono text-[12px] text-subtext">px</span>
      </div>
      <div class="mt-xs font-mono text-[11px] text-subtext">
        predictor: <span id="signal-mode-label" class="text-text">Linear KF</span> · 500&nbsp;ms horizon
      </div>
      <div class="mt-sm">
        <span id="signal-delta" class="inline-flex items-center rounded-full border border-border px-sm py-xs font-mono text-[11px] text-subtext">measuring…</span>
      </div>
      <div class="mt-sm w-full">
        <canvas id="signal-spark" class="w-full"></canvas>
        <div class="mt-xs text-[10px] text-subtext">running RMSE, last ~10 s (shared scale across both predictors)</div>
      </div>
    </div>

    <!-- Legend -->
    <div>
      <div class="demo-kicker mb-sm">legend</div>
      <ul class="flex flex-col gap-xs text-[12px] text-text">
        <li class="flex items-center gap-sm"><span class="inline-block h-3 w-5 rounded-[3px] border-2 border-sapphire bg-sapphire/15"></span>ground truth + ID</li>
        <li class="flex items-center gap-sm"><span class="inline-block h-3 w-5 rounded-[3px] border-2 border-dashed border-sapphire"></span>prediction (same hue, dashed)</li>
        <li class="flex items-center gap-sm"><span class="inline-block h-0.5 w-5 border-t border-dashed border-subtext"></span>prediction error</li>
      </ul>
      <p class="mt-xs text-[11px] leading-relaxed text-subtext">
        Three tracked objects on cornering paths: <span class="text-sapphire">ID1</span> ellipse,
        <span class="text-yellow">ID2</span> fast circle, <span class="text-maroon">ID3</span> wide sweep.
        The dashed box is what the filter predicted 500&nbsp;ms ago for right now.
      </p>
    </div>

    <!-- What's shown + the real benchmark claim, clearly separated -->
    <div class="flex flex-col gap-sm text-[12px] leading-relaxed text-text">
      <div class="demo-kicker">what's shown</div>
      <p>
        Both predictors run the genuine motion-model math: constant-velocity extrapolation
        drifts on curves; CTRV propagation follows them. The RMSE above is computed live
        from the on-screen gap — toggle predictors and watch it respond.
      </p>
      <div class="border-l-2 border-green pl-sm">
        <strong class="text-green">On KITTI:</strong> the full pipeline (CTRV-EKF +
        Hungarian assignment, camera–LiDAR fusion) cut RMSE by
        <span class="font-mono">81.5%</span> vs the linear baseline.
      </div>
    </div>
  </div>
</DemoDialog>

<script>
  import { initSignalDemo } from '../scripts/signal-demo';
  initSignalDemo();
</script>
