---
// Projects section. kindle is the flagship (wide card + code snippet pane);
// anchors (project-*) are deep-link targets for the hero stats strip.
import ProjectCard from './ProjectCard.astro';
import KindleDemo from './KindleDemo.astro';
import AsaDemo from './AsaDemo.astro';
import SignalDemo from './SignalDemo.astro';
import NluDemo from './NluDemo.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.sort((a, b) => (a.data.index || 99) - (b.data.index || 99)).map(p => p.data);
---

<section id="projects" class="px-lg py-3xl md:px-xl">
  <div class="mx-auto max-w-[72rem]">
    <!-- Heading -->
    <div class="reveal">
      <p class="section-eyebrow">work</p>
      <div class="flex items-center gap-md mt-sm">
        <h2 class="gradient-text inline-block text-display font-semibold">Projects</h2>
        {import.meta.env.DEV && (
          <a href="/dev" class="rounded-full border border-border bg-mantle px-sm py-xs text-xs font-semibold text-subtext transition-colors hover:border-accent hover:text-accent">
            <Icon name="lucide:pen-tool" class="inline-block mr-xs" width={12} height={12} /> Add Project
          </a>
        )}
      </div>
      <p class="mt-sm text-body text-subtext">
        Real systems, real depth. Hit <strong class="text-text">Try demo</strong> on a card to see
        it working.
      </p>
    </div>

    <!-- Featured grid: kindle spans two columns at lg -->
    <div class="mt-2xl grid grid-cols-1 gap-lg md:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map((project, i) => (
        <div class="reveal" data-delay={String((i % 3) + 1)}>
          <ProjectCard
            name={project.name}
            description={project.description}
            tech={project.tech}
            href={project.href}
            index={i + 1}
            anchor={project.anchor}
            status={project.status}
            teamCredit={project.teamCredit}
            impact={project.impact}
            role={project.role}
            demoId={project.demoId}
          />
        </div>
      ))}
    </div>


  </div>
</section>

<!-- Demo modals — rendered once, opened via dialog.showModal() -->
<KindleDemo />
<AsaDemo />
<SignalDemo />
<NluDemo />
