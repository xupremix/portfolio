---
// Projects section. incin is the flagship (wide card + code snippet pane);
// anchors (project-*) are deep-link targets for the hero stats strip.
import ProjectCard from './ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.sort((a, b) => (a.data.index || 99) - (b.data.index || 99)).map(p => p.data);
const projectTranslationKeys = ['incin', 'evolcpp', 'mot', 'asa', 'nlu'];
---

<section id="projects" class="px-lg py-3xl md:px-xl">
  <div class="mx-auto max-w-[72rem]">
    <!-- Heading -->
    <div class="reveal">
      <p class="section-eyebrow" data-i18n="projects.eyebrow">work</p>
      <div class="flex items-center gap-md mt-sm">
        <h2 class="gradient-text inline-block text-display font-semibold" data-i18n="projects.title">Projects</h2>
      </div>
      <p class="mt-sm text-body text-subtext" data-i18n="projects.description">
        Selected projects in AI, systems programming, and software engineering.
      </p>
    </div>

    <!-- Featured grid: incin spans two columns at lg -->
    <div class="mt-2xl grid grid-cols-1 gap-lg md:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map((project, i) => (
        <div class="reveal" data-delay={String((i % 3) + 1)}>
          <ProjectCard
            name={project.name}
            description={project.description}
            tech={project.tech}
            href={project.href}
            index={i + 1}
            anchor={project.anchor}
            status={project.status}
            teamCredit={project.teamCredit}
            impact={project.impact}
            role={project.role}
            translationKey={projectTranslationKeys[i]}
          />
        </div>
      ))}
    </div>


  </div>
</section>
