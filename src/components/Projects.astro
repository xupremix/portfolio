---
import ProjectCard from './ProjectCard.astro';

type Project = {
  name: string;
  description: string;
  tech: string[];
  href: string;
  status?: 'in-progress' | 'team';
  teamCredit?: string;
};

const projects: Project[] = [
  {
    name: "kindle",
    description: "A Rust ML library that checks tensor and model invariants at compile time, with ONNX support — catching shape and type errors before a model ever runs.",
    tech: ["Rust", "ONNX"],
    href: "https://github.com/xupremix/kindle",
  },
  {
    name: "evolcpp",
    description: "An in-progress C++ port of kindle, bringing the same compile-time tensor and model invariant checks to a systems-level C++ audience.",
    tech: ["C++"],
    href: "https://github.com/xupremix/evolcpp",
    status: "in-progress",
  },
  {
    name: "signal_image_video",
    description: "Multi-Object Tracking Benchmark Analysis: a tracking-by-detection pipeline spanning Kalman filters to deep appearance embeddings, 3D LiDAR-camera fusion, a PPO-based domain-adversarial tracker (MARLMOT), and a CTRV Extended Kalman Filter that cut RMSE 81.5% over linear models — with a PyQt6 GUI for inspection.",
    tech: ["Python", "PyQt6"],
    href: "https://github.com/xupremix/signal_image_video",
  },
  {
    name: "ASA Autobots",
    description: "A cooperative multi-agent Deliveroo delivery system built with a teammate: a BDI executor, an LLM coordinator (Llama 3.3 70B), and a PDDL symbolic planner working together, backed by ~91.5% test coverage.",
    tech: ["Node.js", "PDDL", "LLM"],
    href: "https://github.com/ale-bena/asa-autobots",
    status: "team",
    teamCredit: "Team project — repo owned by teammate ale-bena.",
  },
  {
    name: "NLU",
    description: "Joint Intent Classification and Slot Filling on the ATIS dataset, comparing a custom GPT-2 trained from scratch against fine-tuned BERT and GPT-2 — the best model reached 0.9509 slot F1 and 0.9765 intent accuracy.",
    tech: ["Python", "PyTorch", "Transformers"],
    href: "https://github.com/xupremix/NLU",
  },
  {
    name: "DL2026_AFA_CC",
    description: "A Deep Learning 2026 coursework project building on and improving 'Clip Clay,' explored end-to-end in Jupyter/Python notebooks.",
    tech: ["Python", "Jupyter"],
    href: "https://github.com/xupremix/DL2026_AFA_CC",
  },
];

const moreOnGithub: { name: string; href: string }[] = [
  { name: "mlgui", href: "https://github.com/xupremix/mlgui" },
  { name: "ai_robot", href: "https://github.com/xupremix/ai_robot" },
  { name: "uom", href: "https://github.com/xupremix/uom" },
  { name: "rmtarget", href: "https://github.com/xupremix/rmtarget" },
  { name: "oxagworldgenerator", href: "https://github.com/xupremix/oxagworldgenerator" },
  { name: "oxagaudiotool", href: "https://github.com/xupremix/oxagaudiotool" },
];
---

<section id="projects" class="py-3xl px-lg md:px-xl">
  <div class="max-w-[72rem] mx-auto">
    <h2 class="text-display font-semibold text-text">Projects</h2>
    <p class="mt-sm text-body text-subtext">Selected work across Rust, Python, and applied ML — see the rest on GitHub.</p>

    <div class="mt-2xl grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg items-stretch">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>

    <div class="mt-xl">
      <h3 class="text-heading font-semibold text-text">More on GitHub</h3>
      <div class="mt-md flex flex-wrap gap-sm">
        {moreOnGithub.map((repo) => (
          <a
            href={repo.href}
            target="_blank"
            rel="noopener noreferrer"
            class="border border-border rounded-full px-md py-xs text-label text-text hover:text-accent focus-visible:text-accent focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none transition-colors"
          >
            {repo.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
