---
import ProjectCard from './ProjectCard.astro';
import KindleDemo from './KindleDemo.astro';
import AsaDemo from './AsaDemo.astro';
import SignalDemo from './SignalDemo.astro';
import NluDemo from './NluDemo.astro';

interface Project {
  name: string;
  description: string;
  tech: string[];
  href: string;
  status?: 'in-progress' | 'team';
  teamCredit?: string;
  impact?: string;
  role?: string;
  demoId?: string;
}

const featuredProjects: Project[] = [
  {
    name: "kindle",
    description:
      "A deep learning framework for Rust built on tch-rs that leverages const generics to encode tensor shapes and data types. This allows the Rust compiler to catch shape mismatches and type errors before runtime, providing a safer ML development experience.",
    tech: ["Rust", "tch-rs", "PyTorch C++", "Generics"],
    href: "https://github.com/xupremix/kindle",
    impact: "Compile-time ML shape & type safety",
    role: "Solo Project",
    demoId: "kindle-demo",
  },
  {
    name: "evolcpp",
    description:
      "A C++ port of kindle. Initially designed as a neuroevolution library to evolve neural network architectures and weights using genetic algorithms, it now serves as a robust C++ implementation of kindle's compile-time safety principles.",
    tech: ["C++", "Templates", "Machine Learning", "CMake"],
    href: "https://github.com/xupremix/evolcpp",
    status: "in-progress",
    impact: "C++ implementation of compile-time shape safety",
    role: "Solo Project",
  },
  {
    name: "signal_image_video",
    description:
      "Multi-object tracking system combining a CTRV-EKF Kalman filter with a Hungarian algorithm assignment step for 3D camera-LiDAR fusion — trained and evaluated on the KITTI benchmark.",
    tech: ["Python", "Kalman Filter", "LiDAR", "KITTI", "NumPy"],
    href: "https://github.com/xupremix/signal_image_video",
    impact: "Reduced RMSE over linear tracking baseline",
    role: "Solo Project",
    demoId: "signal-demo",
  },
  {
    name: "ASA Autobots",
    description:
      "A cooperative multi-agent delivery system where BDI executors, an LLM coordinator (Llama 3.3 70B), and a PDDL planner collaborate in real time to fulfil delivery orders on a shared map.",
    tech: ["Node.js", "PDDL", "BDI", "LLM", "REST API"],
    href: "https://github.com/ale-bena/asa-autobots",
    status: "team",
    teamCredit: "Team project — repo owned by teammate ale-bena.",
    impact: "~91.5% test coverage · 3-layer agent architecture",
    role: "Co-lead · Team of 2",
    demoId: "asa-demo",
  },
  {
    name: "NLU — Intent & Slot Filling",
    description:
      "Natural Language Understanding on the ATIS dataset using BERT fine-tuning with a joint intent classification and slot-filling head — training pipeline built from scratch.",
    tech: ["Python", "PyTorch", "BERT", "ATIS", "HuggingFace"],
    href: "https://github.com/xupremix/NLU",
    impact: "High accuracy intent classification",
    role: "Solo Project",
    demoId: "nlu-demo",
  },
  {
    name: "DL2026_AFA_CC",
    description:
      "Deep learning research project extending Clip Clay — an image editing model — with an improved pipeline for Adaptive Feature Aggregation (AFA) and Color Calibration (CC).",
    tech: ["Python", "PyTorch", "CLIP", "Diffusion Models"],
    href: "https://github.com/xupremix/DL2026_AFA_CC",
    impact: "Improved on Clip Clay end-to-end quality metrics",
    role: "Solo Project",
  },
];

const otherProjects: { name: string; href: string }[] = [
  { name: "mlgui",               href: "https://github.com/xupremix/mlgui" },
  { name: "ai_robot",            href: "https://github.com/xupremix/ai_robot" },
  { name: "uom",                 href: "https://github.com/xupremix/uom" },
  { name: "rmtarget",            href: "https://github.com/xupremix/rmtarget" },
  { name: "oxagworldgenerator",  href: "https://github.com/xupremix/oxagworldgenerator" },
  { name: "oxagaudiotool",       href: "https://github.com/xupremix/oxagaudiotool" },
];
---

<section id="projects" class="py-3xl px-lg md:px-xl">
  <div class="max-w-[72rem] mx-auto">
    <!-- Heading -->
    <div class="reveal">
      <h2 class="text-display font-semibold gradient-text inline-block">Projects</h2>
      <p class="mt-sm text-body text-subtext">
        Real systems, real depth — click <strong class="text-text">Try Demo</strong> on any card to see it working.
      </p>
    </div>

    <!-- Featured grid -->
    <div class="mt-2xl grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">
      {featuredProjects.map((project, i) => (
        <div class="reveal" data-delay={String((i % 3) + 1)}>
          <ProjectCard
            name={project.name}
            description={project.description}
            tech={project.tech}
            href={project.href}
            status={project.status}
            teamCredit={project.teamCredit}
            impact={project.impact}
            role={project.role}
            demoId={project.demoId}
          />
        </div>
      ))}
    </div>

    <!-- More on GitHub -->
    <div class="reveal mt-2xl">
      <p class="text-label font-semibold text-subtext mb-sm">More on GitHub</p>
      <div class="flex flex-wrap gap-sm">
        {otherProjects.map((p) => (
          <a
            href={p.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-label font-mono font-semibold text-text border border-border rounded-md px-sm py-xs hover:text-accent hover:border-accent/40 focus-visible:text-accent focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none transition-colors"
          >
            {p.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Demo modals — rendered once, opened via dialog.showModal() -->
<KindleDemo />
<AsaDemo />
<SignalDemo />
<NluDemo />
