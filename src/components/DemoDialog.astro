---
import { Icon } from 'astro-icon/components';

interface Props {
  id: string;
  title: string;
  subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<dialog id={id} aria-labelledby={`${id}-title`}>
  <!-- Full-height sheet on phones, fixed-height card from md up -->
  <div class="flex h-dvh flex-col md:h-[min(88dvh,720px)]">
    <!-- Header -->
    <header class="flex shrink-0 items-start justify-between gap-md border-b border-border p-md md:px-lg">
      <div class="min-w-0">
        <h2 id={`${id}-title`} class="text-body font-semibold text-text md:text-[18px]">{title}</h2>
        {subtitle && <p class="mt-xs text-label text-subtext"><Fragment set:html={subtitle} /></p>}
        <slot name="subtitle" />
      </div>
      <button
        type="button"
        data-dialog-close
        aria-label="Close demo"
        class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-[var(--radius-control)] border border-border text-subtext transition-colors hover:border-subtext hover:text-text focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
      >
        <Icon name="lucide:x" width={18} height={18} aria-hidden="true" />
      </button>
    </header>

    <!-- Body: main + aside, stacked below lg -->
    <div class="flex min-h-0 flex-1 flex-col overflow-y-auto lg:flex-row lg:overflow-hidden">
      <!-- Below lg the body scrolls and main/aside take natural height
           (flex-none); at lg+ main flexes and aside scrolls independently. -->
      <div class="flex min-w-0 flex-col max-lg:flex-none lg:min-h-0 lg:flex-1">
        <slot name="main" />
      </div>
      {Astro.slots.has('aside') && (
        <aside class="flex shrink-0 flex-col gap-lg border-border p-md max-lg:border-t lg:w-[300px] lg:overflow-y-auto lg:border-l">
          <slot name="aside" />
        </aside>
      )}
    </div>
  </div>
</dialog>

<script>
  // Shared behavior for all demo dialogs — Astro dedupes this script.
  document.querySelectorAll<HTMLButtonElement>('[data-dialog-close]').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.closest('dialog')?.close();
    });
  });

  document.querySelectorAll('dialog').forEach((dialog) => {
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const outside =
        e.clientX < rect.left ||
        e.clientX > rect.right ||
        e.clientY < rect.top ||
        e.clientY > rect.bottom;
      if (outside) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });
  });
</script>
