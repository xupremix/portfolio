---
// Hero: above-the-fold statement, ambient background, call-to-action pair,
// scroll cue, and prominent Master's thesis / internship notice.
import { Icon } from 'astro-icon/components';
---

<section
  id="hero"
  class="relative flex min-h-[92vh] flex-col items-center justify-center overflow-hidden px-lg py-3xl text-center md:px-xl"
>
  <!-- Ambient floating blobs (two accent, one blue; paper-mode overrides in style) -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="hero-blob absolute top-[12%] left-[8%] h-[880px] w-[880px] rounded-full"
      data-parallax="8"
    ></div>
    <div
      class="hero-blob-alt absolute right-[3%] bottom-[8%] h-[700px] w-[700px] rounded-full"
      data-parallax="-6"
    ></div>
    <div
      class="hero-blob-blue absolute top-[35%] left-[40%] h-[750px] w-[750px] rounded-full"
      data-parallax="4"
    ></div>
  </div>

  <!-- Dot grid, fading toward the edges -->
  <div aria-hidden="true" class="hero-dots pointer-events-none absolute inset-0"></div>

  <!-- Content -->
  <div class="relative flex max-w-[56rem] flex-col items-center">
    <p
      class="hero-animate font-mono text-label font-semibold tracking-widest text-subtext uppercase"
      data-delay="2"
    >
      AI Systems Master's Student · CS Graduate · Trento, Italy
    </p>

    <h1 class="hero-animate gradient-text mt-sm text-display font-semibold" data-delay="3">
      Filippo Lollato
    </h1>

    <p
      class="hero-animate mt-md max-w-[44rem] text-[clamp(1.125rem,1rem+0.6vw,1.375rem)] leading-relaxed text-balance text-subtext"
      data-delay="4"
    >
      Engineering <span class="font-semibold text-text">intelligent AI systems</span>, model optimization pipelines, and <span class="font-semibold text-text">production service integrations</span>.
    </p>

    <div class="hero-animate mt-xl flex flex-col items-center gap-md sm:flex-row" data-delay="5">
      <a
        href="#projects"
        class="inline-flex items-center gap-xs rounded-[var(--radius-control)] bg-accent px-md py-sm text-label font-semibold text-base transition-opacity hover:opacity-90 focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
      >
        Explore Featured Projects
        <Icon name="lucide:arrow-down" width={14} height={14} aria-hidden="true" />
      </a>
      <div class="group relative">
        <button
          type="button"
          class="inline-flex items-center gap-xs rounded-[var(--radius-control)] border border-border bg-mantle/40 px-md py-sm text-label font-semibold text-text transition-colors hover:border-accent/40 hover:text-accent focus-visible:text-accent focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
        >
          <Icon name="lucide:file-text" width={14} height={14} aria-hidden="true" />
          Download CV
          <Icon name="lucide:chevron-down" width={12} height={12} class="opacity-70 transition-transform group-hover:rotate-180" aria-hidden="true" />
        </button>
        <div class="absolute left-1/2 top-full z-50 pt-xs hidden w-max min-w-[12rem] -translate-x-1/2 group-hover:block focus-within:block">
          <div class="flex flex-col rounded-[var(--radius-control)] border border-border bg-mantle p-xs shadow-lg" style="background-color: var(--color-mantle); opacity: 1; backdrop-filter: none;">
            <a href="/lollato_filippo_eu_cv_en.pdf" target="_blank" download="Filippo_Lollato_CV_EU_EN.pdf" class="rounded-[var(--radius-control)] px-sm py-xs text-center text-[13px] font-semibold text-text transition-colors hover:bg-accent/10 hover:text-accent focus-visible:bg-accent/10 focus-visible:text-accent focus-visible:outline-none">EU CV (English)</a>
            <a href="/lollato_filippo_eu_cv_it.pdf" target="_blank" download="Filippo_Lollato_CV_EU_IT.pdf" class="rounded-[var(--radius-control)] px-sm py-xs text-center text-[13px] font-semibold text-text transition-colors hover:bg-accent/10 hover:text-accent focus-visible:bg-accent/10 focus-visible:text-accent focus-visible:outline-none">EU CV (Italian)</a>
            <a href="/lollato_filippo_it_cv_en.pdf" target="_blank" download="Filippo_Lollato_CV_IT_EN.pdf" class="rounded-[var(--radius-control)] px-sm py-xs text-center text-[13px] font-semibold text-text transition-colors hover:bg-accent/10 hover:text-accent focus-visible:bg-accent/10 focus-visible:text-accent focus-visible:outline-none">IT CV (English)</a>
            <a href="/lollato_filippo_it_cv_it.pdf" target="_blank" download="Filippo_Lollato_CV_IT_IT.pdf" class="rounded-[var(--radius-control)] px-sm py-xs text-center text-[13px] font-semibold text-text transition-colors hover:bg-accent/10 hover:text-accent focus-visible:bg-accent/10 focus-visible:text-accent focus-visible:outline-none">IT CV (Italian)</a>
          </div>
        </div>
      </div>
    </div>

    <a
      href="#contact"
      class="hero-animate group mt-lg inline-flex items-center gap-xs rounded-full border border-accent/40 bg-accent/10 px-md py-xs text-[13px] font-medium text-accent transition-all hover:bg-accent/20 hover:scale-[1.02] focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
      data-delay="6"
    >
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent/60 motion-reduce:animate-none"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
      </span>
      <span>Open to part-time AI roles &amp; Master's thesis internships</span>
      <Icon name="lucide:arrow-right" width={12} height={12} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
    </a>
  </div>

  <a
    href="#projects"
    id="hero-scroll-cue"
    aria-label="Scroll to projects"
    class="hero-animate absolute bottom-xl text-subtext transition-colors hover:text-accent focus-visible:text-accent focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
    data-delay="6"
  >
    <Icon name="lucide:chevron-down" width={24} height={24} aria-hidden="true" />
  </a>
</section>

<style>
  .hero-blob {
    background: radial-gradient(circle, rgb(203 166 247 / 0.08) 0%, transparent 65%);
    animation: blob-float 20s ease-in-out infinite;
  }
  .hero-blob-alt {
    background: radial-gradient(circle, rgb(203 166 247 / 0.06) 0%, transparent 65%);
    animation: blob-float-alt 25s ease-in-out infinite;
  }
  .hero-blob-blue {
    background: radial-gradient(circle, rgb(137 180 250 / 0.05) 0%, transparent 65%);
    animation: blob-float 30s ease-in-out infinite reverse;
  }
  .hero-dots {
    background-image: radial-gradient(circle, rgb(205 214 244 / 0.07) 1px, transparent 1px);
    background-size: 30px 30px;
    mask-image: radial-gradient(ellipse 85% 75% at 50% 42%, black, transparent);
  }
  :global(html[data-mode='paper']) .hero-blob {
    background: radial-gradient(circle, rgb(78 110 56 / 0.10) 0%, transparent 65%);
  }
  :global(html[data-mode='paper']) .hero-blob-alt {
    background: radial-gradient(circle, rgb(168 95 42 / 0.08) 0%, transparent 65%);
  }
  :global(html[data-mode='paper']) .hero-blob-blue {
    background: radial-gradient(circle, rgb(61 111 142 / 0.07) 0%, transparent 65%);
  }
  :global(html[data-mode='paper']) .hero-dots {
    background-image: radial-gradient(circle, rgb(46 42 32 / 0.12) 1px, transparent 1px);
  }

  #hero-scroll-cue {
    animation: hero-bounce 2.2s ease-in-out infinite;
    animation-delay: 2s;
  }
  @keyframes hero-bounce {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(7px); }
  }
  @media (prefers-reduced-motion: reduce) {
    #hero-scroll-cue,
    .hero-blob,
    .hero-blob-alt,
    .hero-blob-blue { animation: none; }
  }
</style>

<script>
  const fine = window.matchMedia('(pointer: fine)').matches;
  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (fine && motionOk) {
    const blobs = document.querySelectorAll<HTMLElement>('[data-parallax]');
    let targetX = 0;
    let targetY = 0;
    let curX = 0;
    let curY = 0;
    let rafId = 0;

    window.addEventListener(
      'pointermove',
      (e) => {
        targetX = e.clientX / window.innerWidth - 0.5;
        targetY = e.clientY / window.innerHeight - 0.5;
        if (!rafId) rafId = requestAnimationFrame(tick);
      },
      { passive: true },
    );

    function tick() {
      curX += (targetX - curX) * 0.06;
      curY += (targetY - curY) * 0.06;
      blobs.forEach((blob) => {
        const depth = Number(blob.dataset.parallax);
        blob.style.translate = `${curX * depth * 4}px ${curY * depth * 4}px`;
      });
      const settled = Math.abs(targetX - curX) < 0.001 && Math.abs(targetY - curY) < 0.001;
      rafId = settled ? 0 : requestAnimationFrame(tick);
    }
  }
</script>
