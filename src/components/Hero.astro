---
import { Icon } from 'astro-icon/components';
---

<section
  id="hero"
  class="relative flex flex-col items-center justify-center text-center px-lg md:px-xl min-h-[calc(100vh_-_64px)] overflow-hidden"
>
  <!-- Animated gradient blobs -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute top-[15%] left-[10%] w-[700px] h-[700px] rounded-full"
      style="background: radial-gradient(circle, rgb(203 166 247 / 0.08) 0%, transparent 65%); animation: blob-float 20s ease-in-out infinite;"
    ></div>
    <div
      class="absolute bottom-[10%] right-[5%] w-[550px] h-[550px] rounded-full"
      style="background: radial-gradient(circle, rgb(203 166 247 / 0.06) 0%, transparent 65%); animation: blob-float-alt 25s ease-in-out infinite;"
    ></div>
  </div>

  <!-- Subtle dot grid -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background-image: radial-gradient(circle, rgb(205 214 244 / 0.07) 1px, transparent 1px); background-size: 30px 30px;"
  ></div>

  <!-- Content -->
  <div class="relative flex flex-col items-center max-w-[52rem]">
    <p
      class="hero-animate text-label font-mono font-semibold text-accent tracking-widest uppercase"
      data-delay="1"
    >
      CS Graduate · AI Master's Student @ UniTrento
    </p>

    <h1
      class="hero-animate mt-sm text-display font-semibold text-text"
      data-delay="2"
    >
      Filippo Lollato
    </h1>

    <p
      class="hero-animate mt-md text-heading font-semibold text-subtext"
      data-delay="3"
      style="line-height: 1.35;"
    >
      I build robust systems from the ground up —<br />
      whether it's exploring <span class="text-text">compile-time safety in Rust</span>,<br class="hidden sm:block" />
      multi-agent AI, or tracking algorithms.
    </p>

    <div
      class="hero-animate mt-xl flex flex-col sm:flex-row items-center gap-md"
      data-delay="4"
    >
      <a
        href="#projects"
        class="inline-flex items-center gap-xs bg-accent text-base rounded-md px-md py-sm text-label font-semibold focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none hover:opacity-90 transition-opacity"
      >
        See my work
        <Icon name="lucide:arrow-down" width={14} height={14} aria-hidden="true" />
      </a>
      <a
        href="#contact"
        class="text-label font-semibold text-text hover:text-accent focus-visible:text-accent focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none transition-colors"
      >
        Get in touch →
      </a>
    </div>
  </div>

  <a
    href="#projects"
    id="hero-scroll-cue"
    aria-label="Scroll to projects"
    class="hero-animate absolute bottom-xl text-subtext hover:text-accent focus-visible:text-accent focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none transition-colors"
    data-delay="5"
  >
    <Icon name="lucide:chevron-down" width={24} height={24} aria-hidden="true" />
  </a>
</section>

<style>
  #hero-scroll-cue {
    animation: hero-bounce 2.2s ease-in-out infinite;
    animation-delay: 1.8s;
  }
  @keyframes hero-bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(7px); }
  }
  @media (prefers-reduced-motion: reduce) {
    #hero-scroll-cue { animation: none; }
  }
</style>
