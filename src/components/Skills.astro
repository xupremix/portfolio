---
// Skill groups. Primary skills use the Badge `primary` variant; the
// `progress` variant is reserved for in-progress project markers.
import Badge from './Badge.astro';
import { Icon } from 'astro-icon/components';

const skillGroups: { heading: string; icon: string; items: string[]; primary?: string[] }[] = [
  {
    heading: 'Systems & Languages',
    icon: 'lucide:cpu',
    items: ['Rust', 'C++', 'Python'],
    primary: ['Rust', 'Python'],
  },
  {
    heading: 'ML Frameworks',
    icon: 'lucide:brain',
    items: ['PyTorch', 'tch-rs', 'Burn', 'ONNX', 'HuggingFace Transformers'],
    primary: ['PyTorch'],
  },
  {
    heading: 'ML Deployment',
    icon: 'lucide:server',
    items: ['ONNX Runtime', 'Axum', 'REST APIs', 'Docker'],
  },
  {
    heading: 'Tools & Other',
    icon: 'lucide:wrench',
    items: ['Git', 'Node.js', 'PDDL', 'PyQt6', 'Jupyter'],
  },
];
---

<section id="skills" class="px-lg py-3xl md:px-xl">
  <div class="mx-auto max-w-[72rem]">
    <div class="reveal">
      <p class="section-eyebrow">skills</p>
      <h2 class="gradient-text mt-sm inline-block text-display font-semibold">Skills</h2>
      <p class="mt-sm text-body text-subtext">
        The tools I reach for when building systems that actually run.
      </p>
    </div>

    <div class="mt-2xl grid grid-cols-1 gap-lg sm:grid-cols-2 lg:grid-cols-4">
      {skillGroups.map((group, i) => (
        <div
          class="reveal flex flex-col gap-sm rounded-[var(--radius-card)] border border-border border-l-2 border-l-accent/50 bg-mantle p-md"
          data-delay={String(i + 1)}
        >
          <div class="flex items-center gap-sm">
            <span class="flex h-7 w-7 items-center justify-center rounded-[6px] bg-accent/10 text-accent">
              <Icon name={group.icon} width={14} height={14} aria-hidden="true" />
            </span>
            <h3 class="text-label font-semibold tracking-wider text-subtext uppercase">
              {group.heading}
            </h3>
          </div>
          <div class="flex flex-wrap gap-xs">
            {group.items.map((item) => (
              <Badge label={item} variant={group.primary?.includes(item) ? 'primary' : 'default'} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
