---
// Skill groups. Primary skills use the Badge `primary` variant; the
// `progress` variant is reserved for in-progress project markers.
import Badge from './Badge.astro';
import { Icon } from 'astro-icon/components';

import skillGroupsData from '../data/skills.json';

const skillGroups: { heading: string; icon: string; items: string[]; primary?: string[]; color?: string }[] = skillGroupsData;

const tone: Record<string, { text: string; bg: string; border: string; lBorder: string }> = {
  accent: { text: 'text-accent', bg: 'bg-accent/10', border: 'border-accent/40', lBorder: 'border-l-accent/50' },
  blue: { text: 'text-blue', bg: 'bg-blue/10', border: 'border-blue/40', lBorder: 'border-l-blue/50' },
  green: { text: 'text-green', bg: 'bg-green/10', border: 'border-green/40', lBorder: 'border-l-green/50' },
  yellow: { text: 'text-yellow', bg: 'bg-yellow/10', border: 'border-yellow/40', lBorder: 'border-l-yellow/50' },
  maroon: { text: 'text-maroon', bg: 'bg-maroon/10', border: 'border-maroon/40', lBorder: 'border-l-maroon/50' },
  peach: { text: 'text-peach', bg: 'bg-peach/10', border: 'border-peach/40', lBorder: 'border-l-peach/50' },
};
---

<section id="skills" class="px-lg py-3xl md:px-xl">
  <div class="mx-auto max-w-[72rem]">
    <div class="reveal">
      <p class="section-eyebrow">skills</p>
      <div class="flex items-center gap-md mt-sm">
        <h2 class="gradient-text inline-block text-display font-semibold">Skills</h2>
        {import.meta.env.DEV && (
          <a href="/dev/skills" class="rounded-full border border-border bg-mantle px-sm py-xs text-xs font-semibold text-subtext transition-colors hover:border-accent hover:text-accent">
            <Icon name="lucide:pen-tool" class="inline-block mr-xs" width={12} height={12} /> Edit
          </a>
        )}
      </div>
      <p class="mt-sm text-body text-subtext">
        The tools I reach for when building systems that actually run.
      </p>
    </div>

    <div class="mt-2xl grid grid-cols-1 gap-lg sm:grid-cols-2 lg:grid-cols-4">
      {skillGroups.map((group, i) => {
        const currentTone = tone[group.color || 'accent'] || tone['accent'];
        return (
        <div
          class:list={[
            "reveal flex flex-col gap-sm rounded-[var(--radius-card)] border border-border border-l-2 bg-mantle p-md",
            currentTone.lBorder
          ]}
          data-delay={String(i + 1)}
        >
          <div class="flex items-center gap-sm">
            <span class:list={["flex h-7 w-7 items-center justify-center rounded-[6px]", currentTone.bg, currentTone.text]}>
              <Icon name={group.icon} width={14} height={14} aria-hidden="true" />
            </span>
            <h3 class="text-label font-semibold tracking-wider text-subtext uppercase">
              {group.heading}
            </h3>
          </div>
          <div class="flex flex-wrap gap-xs">
            {group.items.map((item) => (
              group.primary?.includes(item) ? (
                <span class:list={["rounded-full border px-sm py-xs text-label font-medium shadow-sm", currentTone.border, currentTone.bg, currentTone.text]}>{item}</span>
              ) : (
                <span class="rounded-full border border-border bg-base px-sm py-xs text-label font-medium text-text shadow-sm">{item}</span>
              )
            ))}
          </div>
        </div>
      )})}
    </div>
  </div>
</section>
