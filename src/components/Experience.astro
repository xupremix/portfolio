---
// Experience: timeline rail with tokened tag colors (no inline hex).
import { Icon } from 'astro-icon/components';
import experienceData from '../data/experience.json';

const experience: {
  role: string;
  org: string;
  period: string;
  description: string;
  tag: string;
  toneClass: string; // dot + tag pill tone, from theme tokens
  documents?: { label: string; href: string; filename: string; title: string }[];
}[] = experienceData;
const timelineKeys = ['msc', 'tutor', 'bsc', 'highschool'];

const tone: Record<string, { dot: string; pill: string }> = {
  accent: { dot: 'bg-accent', pill: 'border-accent/40 bg-accent/10 text-accent' },
  green: { dot: 'bg-green', pill: 'border-green/40 bg-green/10 text-green' },
  blue: { dot: 'bg-blue', pill: 'border-blue/40 bg-blue/10 text-blue' },
  maroon: { dot: 'bg-maroon', pill: 'border-maroon/40 bg-maroon/10 text-maroon' },
  yellow: { dot: 'bg-yellow', pill: 'border-yellow/40 bg-yellow/10 text-yellow' },
  peach: { dot: 'bg-peach', pill: 'border-peach/40 bg-peach/10 text-peach' },
};
---

<section id="experience" class="px-lg py-3xl md:px-xl">
  <div class="mx-auto max-w-[72rem]">
    <div class="reveal">
      <p class="section-eyebrow" data-i18n="experience.eyebrow">experience &amp; education</p>
      <div class="flex items-center gap-md mt-sm">
        <h2 class="gradient-text inline-block text-display font-semibold" data-i18n="experience.title">Experience &amp; Education</h2>
      </div>
      <p class="mt-sm text-body text-subtext" data-i18n="experience.description">Where I study, teach, and build.</p>
    </div>

    <!-- Timeline: vertical rail with a tone dot per entry -->
    <div class="relative mt-2xl flex flex-col gap-xl border-l-2 border-border pl-xl">
      {experience.map((item, i) => (
        <div class="reveal relative" data-delay={String(i + 1)}>
          <span
            class:list={[
              'absolute top-[6px] -left-[41px] h-2.5 w-2.5 rounded-full ring-4 ring-base',
              tone[item.toneClass].dot,
            ]}
            aria-hidden="true"
          ></span>
          <div class="flex flex-col gap-sm rounded-[var(--radius-card)] p-sm transition-colors hover:bg-mantle/60">
            <div class="flex flex-col gap-xs sm:flex-row sm:items-center sm:justify-between">
              <div class="flex flex-col gap-xs">
                <h3 class="text-title font-semibold text-text" data-i18n={`experience.role.${timelineKeys[i]}`}>{item.role}</h3>
                <div class="flex flex-wrap items-center gap-sm">
                  <p class="text-label font-semibold text-accent" data-i18n={`experience.org.${i === 3 ? 'highschool' : 'university'}`}>{item.org}</p>
                  <span
                    class:list={[
                      'rounded-full border px-sm py-xs text-label font-semibold',
                      tone[item.toneClass].pill,
                    ]}
                  >
                    <span data-i18n={`experience.tag.${i === 0 ? 'msc' : i === 1 ? 'tutor' : 'education'}`}>{item.tag}</span>
                  </span>
                </div>
              </div>
              <div class="flex flex-wrap items-center gap-sm self-start sm:self-center">
                <span class="font-mono text-label font-semibold text-subtext" data-i18n={`experience.period.${timelineKeys[i]}`}>{item.period}</span>
                {item.documents && item.documents.length > 0 && (
                  <details class="certificate-menu group relative">
                    <summary class="flex list-none cursor-pointer items-center gap-xs rounded-full border border-blue/30 bg-blue/5 px-sm py-xs text-xs font-semibold text-text transition-colors hover:border-blue/60 hover:bg-blue/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue/60">
                      <Icon name="lucide:download" width={13} height={13} aria-hidden="true" />
                      <span data-i18n="experience.degreeMenu">Degree documents</span>
                      <span class="font-mono text-[10px] text-blue">EN / IT</span>
                      <Icon name="lucide:chevron-down" width={12} height={12} aria-hidden="true" />
                    </summary>
                    <div class="absolute right-0 top-full z-30 mt-xs flex min-w-36 flex-col gap-0.5 rounded-xl border border-border bg-crust p-xs shadow-xl">
                      {item.documents.map((document) => {
                        const language = document.label.replaceAll('[', '').replaceAll(']', '');
                        return (
                          <a
                            href={document.href}
                            download={document.filename}
                            aria-label={document.title}
                            title={document.title}
                            class="flex items-center gap-sm rounded-lg px-sm py-xs text-xs font-medium text-subtext transition-colors hover:bg-blue/10 hover:text-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue/60"
                          >
                            <Icon name="lucide:download" width={13} height={13} aria-hidden="true" />
                            <span data-i18n={language === 'EN' ? 'experience.english' : 'experience.italian'}>{language === 'EN' ? 'English' : 'Italian'}</span>
                            <span class="ml-auto font-mono text-[10px] text-blue">{language}</span>
                          </a>
                        );
                      })}
                    </div>
                  </details>
                )}
              </div>
            </div>
            <p class="max-w-[52rem] text-body text-text" data-i18n={`experience.description.${timelineKeys[i]}`}>{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.certificate-menu').forEach((menu) => {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => { menu.open = false; });
    });
  });

  document.addEventListener('click', (event) => {
    document.querySelectorAll<HTMLDetailsElement>('.certificate-menu[open]').forEach((menu) => {
      if (!menu.contains(event.target as Node)) menu.open = false;
    });
  });
</script>
