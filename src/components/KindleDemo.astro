---
// kindle demo — real kindle API scenarios (captured rustc output) + a live
// playground sandbox. All logic in src/scripts/kindle-demo.ts.
import DemoDialog from './DemoDialog.astro';
import { Icon } from 'astro-icon/components';

const tabs = [
  { label: 'Shape mismatch', dot: 'bg-destructive' },
  { label: 'Dtype mismatch', dot: 'bg-destructive' },
  { label: 'Compiles + runs', dot: 'bg-green' },
  { label: 'Sandbox · live rustc', dot: 'bg-accent' },
];
---

<DemoDialog
  id="kindle-demo"
  title="kindle — compile-time ML safety"
  subtitle={`Real kindle API scenarios, plus a live sandbox on <a href="https://play.rust-lang.org" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">play.rust-lang.org</a>`}
>
  <div slot="main" class="flex min-h-0 flex-1 flex-col">
    <!-- Scenario tabs -->
    <div role="tablist" class="flex shrink-0 gap-xs overflow-x-auto border-b border-border p-sm">
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          class:list={[
            'kindle-tab inline-flex shrink-0 cursor-pointer items-center gap-sm rounded-[var(--radius-control)] border px-md py-xs font-mono text-[12px] font-semibold whitespace-nowrap transition-colors',
            i === 0 ? 'border-accent bg-accent/15 text-accent' : 'border-border bg-transparent text-subtext',
          ]}
        >
          <span class:list={['h-2 w-2 rounded-full', tab.dot]} aria-hidden="true"></span>
          {tab.label}
        </button>
      ))}
    </div>

    <!-- CodeMirror mounts here (lazy-loaded on first open) -->
    <div id="kindle-editor" class="h-[280px] min-h-0 lg:h-auto lg:flex-1"></div>

    <!-- Controls -->
    <div class="flex shrink-0 flex-wrap items-center gap-md border-t border-border p-sm px-md">
      <button
        id="kindle-compile-btn"
        type="button"
        class="hidden cursor-pointer items-center gap-xs rounded-[var(--radius-control)] bg-accent px-md py-xs text-[13px] font-bold text-base transition-opacity hover:opacity-90 focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
      >
        <Icon name="lucide:play" width={13} height={13} aria-hidden="true" />
        Compile
      </button>
      <span id="kindle-live-hint" class="text-[12px] text-subtext">
        Edits here aren't compiled — the Sandbox tab runs live rustc.
      </span>
      <span id="kindle-status" class="font-mono text-[12px] text-subtext"></span>
    </div>
  </div>

  <div slot="aside">
    <!-- Compiler output -->
    <div>
      <div class="mb-sm flex items-center justify-between">
        <span class="demo-kicker">rustc output</span>
        <button
          id="kindle-copy-btn"
          type="button"
          aria-label="Copy compiler output"
          class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-[var(--radius-control)] border border-border text-subtext transition-colors hover:border-subtext hover:text-text focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
        >
          <Icon name="lucide:copy" width={13} height={13} aria-hidden="true" />
        </button>
      </div>
      <pre
        id="kindle-output"
        class="min-h-[140px] rounded-[var(--radius-control)] bg-base p-sm font-mono text-[12px] leading-relaxed whitespace-pre-wrap break-words"></pre>
    </div>

    <!-- Per-scenario explanation -->
    <div class="mt-lg">
      <div class="demo-kicker mb-sm">what's happening</div>
      <p id="kindle-explanation" class="text-[13px] leading-relaxed text-text"></p>
    </div>

    <!-- Provenance — where the output really comes from -->
    <div class="mt-lg border-l-2 border-accent/50 pl-sm">
      <div class="demo-kicker mb-xs">provenance</div>
      <p id="kindle-source-note" class="text-[12px] leading-relaxed text-subtext"></p>
    </div>
  </div>
</DemoDialog>

<script>
  import { initKindleDemo } from '../scripts/kindle-demo';
  initKindleDemo();
</script>
