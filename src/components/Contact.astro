---
// Contact: closing statement, mailto + copy-email actions, availability line.
import { Icon } from 'astro-icon/components';

const email = 'contact@lollato.dev';
---

<section id="contact" class="border-t border-border/40 px-lg py-3xl md:px-xl">
  <div class="mx-auto max-w-[72rem]">
    <div class="reveal">
      <p class="section-eyebrow">contact</p>
      <h2 class="gradient-text mt-sm inline-block pb-sm text-display font-semibold">
        Let's build something real.
      </h2>
      <p class="mt-md max-w-[44rem] text-[clamp(1.125rem,1rem+0.6vw,1.375rem)] leading-relaxed text-subtext">
        I am looking for <strong class="text-text">part-time AI or software engineering work</strong> alongside my MSc, and industry Master's thesis internships. I am especially interested in model optimization, production AI services, and multi-agent systems.
      </p>
    </div>

    <div class="reveal relative z-10 mt-2xl flex flex-col gap-md sm:flex-row sm:items-center" data-delay="1">
      <div class="group flex relative items-center">
        <a
          href={`mailto:${email}`}
          class="peer inline-flex items-center justify-center gap-sm rounded-[var(--radius-control)] bg-accent pl-md pr-xl py-sm text-label font-semibold text-base transition-opacity hover:opacity-90 focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
        >
          <Icon name="lucide:mail" width={16} height={16} aria-hidden="true" />
          {email}
        </a>
        <button
          id="copy-email"
          type="button"
          data-email={email}
          class="absolute right-1 opacity-0 group-hover:opacity-100 transition-opacity focus-visible:opacity-100 inline-flex items-center justify-center rounded-[var(--radius-control)] p-xs text-base hover:bg-black/10 focus-visible:ring-2 focus-visible:ring-black/50 focus-visible:outline-none"
          aria-label="Copy email address"
          title="Copy email address"
        >
          <span id="copy-email-idle" class="inline-flex items-center">
            <Icon name="lucide:copy" width={16} height={16} aria-hidden="true" />
          </span>
          <span id="copy-email-done" class="hidden items-center text-green">
            <Icon name="lucide:check" width={16} height={16} aria-hidden="true" />
          </span>
        </button>
      </div>

      <div class="group relative z-50">
        <button
          type="button"
          class="inline-flex w-full sm:w-auto items-center justify-center gap-xs rounded-[var(--radius-control)] border border-border bg-mantle/40 px-md py-sm text-label font-semibold text-text transition-colors hover:border-accent/40 hover:text-accent focus-visible:text-accent focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
        >
          <Icon name="lucide:file-text" width={14} height={14} aria-hidden="true" />
          Download CV
          <Icon name="lucide:chevron-down" width={12} height={12} class="opacity-70 transition-transform group-hover:rotate-180" aria-hidden="true" />
        </button>
        <div class="absolute left-1/2 top-full z-50 pt-xs hidden w-max min-w-[12rem] -translate-x-1/2 group-hover:block focus-within:block">
          <div class="flex flex-col rounded-[var(--radius-control)] border border-border bg-mantle p-xs shadow-lg" style="background-color: var(--color-mantle); opacity: 1; backdrop-filter: none;">
            <a href="/lollato_filippo_eu_cv_en.pdf" target="_blank" download="Filippo_Lollato_CV_EU_EN.pdf" class="rounded-[var(--radius-control)] px-sm py-xs text-center text-[13px] font-semibold text-text transition-colors hover:bg-accent/10 hover:text-accent focus-visible:bg-accent/10 focus-visible:text-accent focus-visible:outline-none">EU CV (English)</a>
            <a href="/lollato_filippo_eu_cv_it.pdf" target="_blank" download="Filippo_Lollato_CV_EU_IT.pdf" class="rounded-[var(--radius-control)] px-sm py-xs text-center text-[13px] font-semibold text-text transition-colors hover:bg-accent/10 hover:text-accent focus-visible:bg-accent/10 focus-visible:text-accent focus-visible:outline-none">EU CV (Italian)</a>
            <a href="/lollato_filippo_it_cv_en.pdf" target="_blank" download="Filippo_Lollato_CV_IT_EN.pdf" class="rounded-[var(--radius-control)] px-sm py-xs text-center text-[13px] font-semibold text-text transition-colors hover:bg-accent/10 hover:text-accent focus-visible:bg-accent/10 focus-visible:text-accent focus-visible:outline-none">IT CV (English)</a>
            <a href="/lollato_filippo_it_cv_it.pdf" target="_blank" download="Filippo_Lollato_CV_IT_IT.pdf" class="rounded-[var(--radius-control)] px-sm py-xs text-center text-[13px] font-semibold text-text transition-colors hover:bg-accent/10 hover:text-accent focus-visible:bg-accent/10 focus-visible:text-accent focus-visible:outline-none">IT CV (Italian)</a>
          </div>
        </div>
      </div>

      <a
        href="https://github.com/xupremix"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-sm rounded-[var(--radius-control)] border border-border px-md py-sm text-label font-semibold text-text transition-colors hover:border-accent/40 hover:text-accent focus-visible:text-accent focus-visible:ring-2 focus-visible:ring-accent/60 focus-visible:outline-none"
      >
        <Icon name="lucide:github" width={16} height={16} aria-hidden="true" />
        github.com/xupremix
      </a>
    </div>

  </div>
</section>

<script>
  const btn = document.getElementById('copy-email');
  btn?.addEventListener('click', async () => {
    const email = (btn as HTMLElement).dataset.email ?? '';
    try {
      await navigator.clipboard.writeText(email);
      document.getElementById('copy-email-idle')?.classList.add('hidden');
      const done = document.getElementById('copy-email-done');
      done?.classList.remove('hidden');
      done?.classList.add('inline-flex');
      setTimeout(() => {
        document.getElementById('copy-email-idle')?.classList.remove('hidden');
        done?.classList.add('hidden');
        done?.classList.remove('inline-flex');
      }, 1600);
    } catch {
      // Clipboard unavailable
    }
  });
</script>
