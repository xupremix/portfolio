---
import { Icon } from 'astro-icon/components';
---

<section id="languages" class="px-lg pb-3xl md:px-xl">
  <div class="mx-auto max-w-[72rem]">
    <div class="reveal">
      <p class="section-eyebrow" data-i18n="languages.eyebrow">languages</p>
      <h2 class="gradient-text mt-sm inline-block pb-[0.08em] text-display font-semibold" data-i18n="languages.title">Languages</h2>
    </div>

    <div class="mt-xl grid grid-cols-1 gap-md sm:grid-cols-2">
      <article class="reveal flex flex-col gap-sm rounded-[var(--radius-card)] border border-blue/30 bg-mantle/75 p-lg" data-delay="1">
        <div class="flex items-center justify-between gap-sm">
          <h3 class="text-title font-semibold text-text" data-i18n="languages.english">English</h3>
          <span class="rounded-full border border-blue/40 bg-blue/10 px-sm py-xs font-mono text-xs font-semibold text-blue">C1</span>
        </div>
        <p class="text-body text-subtext" data-i18n="languages.englishDetail">Cambridge English · Grade A · Score 182</p>
      </article>

      <article class="reveal flex flex-col gap-sm rounded-[var(--radius-card)] border border-green/30 bg-mantle/75 p-lg" data-delay="2">
        <div class="flex items-center justify-between gap-sm">
          <h3 class="text-title font-semibold text-text" data-i18n="languages.italian">Italian</h3>
          <span class="rounded-full border border-green/40 bg-green/10 px-sm py-xs font-mono text-xs font-semibold text-green" data-i18n="languages.native">Native</span>
        </div>
        <p class="text-body text-subtext" data-i18n="languages.italianDetail">Native language</p>
      </article>
    </div>

    <div class="reveal mt-md" data-delay="3">
      <a
        href="/documents/Cambridge_English_Statement_of_Results.pdf"
        download="Cambridge_English_Statement_of_Results.pdf"
        class="inline-flex items-center gap-sm rounded-[var(--radius-control)] border border-blue/35 bg-blue/5 px-md py-sm text-label font-semibold text-text transition-colors hover:border-blue/60 hover:bg-blue/10 hover:text-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue/60"
      >
        <Icon name="lucide:download" width={15} height={15} aria-hidden="true" />
        <span data-i18n="languages.download">Download Cambridge English Statement of Results</span>
        <span class="rounded bg-blue/10 px-xs py-0.5 font-mono text-[10px] text-blue">PDF</span>
      </a>
    </div>
  </div>
</section>
