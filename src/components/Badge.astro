---
// Pill badge.
// - default:  neutral tech/tag chip
// - primary:  a highlighted skill (accent tint)
// - progress: work-in-progress marker (outline accent)
interface Props {
  label: string;
  variant?: 'default' | 'primary' | 'progress';
}

const { label, variant = 'default' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-sm py-xs font-mono text-[12px]',
    variant === 'primary' && 'border border-accent/60 bg-accent/10 font-semibold text-accent',
    variant === 'progress' && 'border border-accent text-accent',
    variant === 'default' && 'border border-border bg-mantle text-subtext',
  ]}
>
  {label}
</span>
