---
// Project card. `wide` + the `extra` slot make the flagship variant (incin):
// content on the left, a code snippet pane on the right at lg+.
// `anchor` gives the card a stable id so hero stats can deep-link to it.
import { Icon } from 'astro-icon/components';
import Badge from './Badge.astro';

interface Props {
  name: string;
  description: string;
  tech: string[];
  href: string;
  index: number; // 1-based position, rendered as 01, 02, …
  anchor?: string;
  status?: 'in-progress' | 'team';
  teamCredit?: string;
  impact?: string;
  role?: string;
  wide?: boolean;
}

const { name, description, tech, href, index, anchor, status, teamCredit, impact, role, wide = false } =
  Astro.props;

const pastelAccents = ['#f2b8a2', '#c4b5fd', '#a7e8cf', '#a9d8f5', '#f3b4ce', '#f0d58a'];
const projectAccent = pastelAccents[(index - 1) % pastelAccents.length];
---

<article
  id={anchor}
  style={`--project-accent: ${projectAccent}`}
  class="project-card card-hover group relative flex h-full scroll-mt-24 flex-col overflow-hidden rounded-[var(--radius-card)] border p-md"
>
  <div aria-hidden="true" class="project-card-light pointer-events-none absolute inset-0"></div>
  <canvas aria-hidden="true" class="project-network-canvas pointer-events-none absolute right-0 top-0 h-3/5 w-3/5"></canvas>
  <div aria-hidden="true" class="project-card-stripe pointer-events-none absolute inset-x-0 top-0 h-1"></div>

  <div class:list={['relative z-10 flex h-full flex-col gap-md', wide && 'lg:grid lg:grid-cols-[1fr_minmax(0,340px)] lg:gap-lg']}>
    <div class="flex h-full min-w-0 flex-col gap-md">
      <!-- Header -->
      <div class="flex flex-col gap-xs">
        <div class="flex items-start justify-between gap-sm">
          <h3 class="flex items-baseline gap-sm text-title leading-snug font-semibold text-text">
            <span class="project-number font-mono text-[13px] font-bold">{String(index).padStart(2, '0')}</span>
            {name}
          </h3>
          <div class="flex shrink-0 items-center gap-xs pt-xs">
            {status === 'in-progress' && <Badge label="In Progress" variant="progress" />}
            {status === 'team' && <Badge label="Team" variant="default" />}
          </div>
        </div>
        {role && <p class="project-role w-fit rounded-full px-sm py-0.5 font-mono text-[11px]">{role}</p>}
        {status === 'team' && teamCredit && <p class="text-label text-subtext italic">{teamCredit}</p>}
      </div>

      <!-- Description -->
      <p class="text-body text-text">{description}</p>

      <!-- Impact callout -->
      {impact && (
        <div class="project-impact rounded-r-sm border-l-2 py-xs pl-sm">
          <p class="font-mono text-[12px] font-semibold">{impact}</p>
        </div>
      )}

      <!-- Tech badges -->
      <div class="flex flex-wrap gap-xs">
        {tech.map((item) => (
          <span class="project-tech-tag inline-flex items-center rounded-full px-sm py-xs font-mono text-[12px]">{item}</span>
        ))}
      </div>

      <!-- Project link -->
      <div class="mt-auto flex flex-wrap items-center gap-md pt-xs">
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link inline-flex items-center gap-xs rounded-full px-md py-xs text-label font-semibold text-text transition-colors focus-visible:ring-2 focus-visible:outline-none"
        >
          <Icon name="lucide:github" width={16} height={16} aria-hidden="true" />
          View on GitHub
        </a>
      </div>
    </div>

    {wide && (
      <div class="hidden min-w-0 lg:block">
        <slot name="extra" />
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    border-color: color-mix(in srgb, var(--project-accent) 15%, var(--color-border));
    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--project-accent) 4%, transparent), transparent 48%),
      var(--color-mantle);
  }

  .project-card-light {
    background: radial-gradient(130px circle at var(--pointer-x, 100%) var(--pointer-y, 0%), color-mix(in srgb, var(--project-accent) 7%, transparent), transparent 100%);
    opacity: 0.7;
    transition: opacity 250ms ease;
  }

  .project-network-canvas {
    opacity: 0.13;
    mask-image: linear-gradient(135deg, transparent 0%, #000 35%, #000 76%, transparent 100%);
    transition: opacity 250ms ease;
  }

  .project-card-stripe {
    background: linear-gradient(90deg, var(--project-accent), color-mix(in srgb, var(--project-accent) 20%, transparent) 75%, transparent);
    opacity: 0.24;
  }

  .project-number {
    color: var(--project-accent);
    text-shadow: 0 0 20px color-mix(in srgb, var(--project-accent) 35%, transparent);
  }

  .project-role,
  .project-tech-tag,
  .project-link {
    border: 1px solid color-mix(in srgb, var(--project-accent) 22%, transparent);
    background: color-mix(in srgb, var(--project-accent) 5%, var(--color-mantle));
  }

  .project-role,
  .project-tech-tag { color: color-mix(in srgb, var(--project-accent) 42%, var(--color-text)); }

  .project-impact {
    border-color: color-mix(in srgb, var(--project-accent) 55%, transparent);
    background: color-mix(in srgb, var(--project-accent) 4%, transparent);
    color: color-mix(in srgb, var(--project-accent) 48%, var(--color-text));
  }

  .project-link:hover {
    border-color: color-mix(in srgb, var(--project-accent) 65%, transparent);
    background: color-mix(in srgb, var(--project-accent) 17%, var(--color-mantle));
    color: var(--project-accent);
  }

  .project-link:focus-visible { --tw-ring-color: var(--project-accent); }

  .project-card:hover { border-color: color-mix(in srgb, var(--project-accent) 30%, var(--color-border)); }
  .project-card:hover .project-network-canvas { opacity: 0.2; }
  .project-card:hover .project-card-light { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .project-network-canvas,
    .project-card-light { transition: none; }
  }
</style>

<script>
  type NetworkNode = { col: number; row: number; phase: number };
  type NetworkCard = {
    canvas: HTMLCanvasElement;
    context: CanvasRenderingContext2D;
    card: HTMLElement;
    nodes: NetworkNode[];
    columns: number;
    rows: number;
    width: number;
    height: number;
    dpr: number;
    pointer: { x: number; y: number } | null;
    color: string;
  };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const networkCards: NetworkCard[] = [];

  document.querySelectorAll<HTMLCanvasElement>('.project-network-canvas').forEach((canvas) => {
    const card = canvas.closest<HTMLElement>('.project-card');
    const context = canvas.getContext('2d');
    if (!card || !context) return;

    const columns = 7;
    const rows = 5;
    const nodes: NetworkNode[] = [];
    for (let row = 0; row < rows; row++) {
      for (let col = 0; col < columns; col++) {
        nodes.push({ col, row, phase: Math.sin(col * 12.9898 + row * 78.233) * Math.PI });
      }
    }

    const network: NetworkCard = {
      canvas,
      context,
      card,
      nodes,
      columns,
      rows,
      width: 0,
      height: 0,
      dpr: Math.min(window.devicePixelRatio || 1, 2),
      pointer: null,
      color: getComputedStyle(card).getPropertyValue('--project-accent').trim(),
    };
    networkCards.push(network);

    const resize = () => {
      const bounds = canvas.getBoundingClientRect();
      network.width = bounds.width;
      network.height = bounds.height;
      canvas.width = Math.round(bounds.width * network.dpr);
      canvas.height = Math.round(bounds.height * network.dpr);
      context.setTransform(network.dpr, 0, 0, network.dpr, 0, 0);
    };

    new ResizeObserver(resize).observe(canvas);
    resize();

    card.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      const bounds = card.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width;
      const y = (event.clientY - bounds.top) / bounds.height;
      card.style.setProperty('--pointer-x', `${x * 100}%`);
      card.style.setProperty('--pointer-y', `${y * 100}%`);

      const canvasBounds = canvas.getBoundingClientRect();
      network.pointer = { x: event.clientX - canvasBounds.left, y: event.clientY - canvasBounds.top };
      if (reduceMotion) drawNetworks(performance.now());
    });

    card.addEventListener('pointerleave', () => {
      card.style.removeProperty('--pointer-x');
      card.style.removeProperty('--pointer-y');
      network.pointer = null;
      if (reduceMotion) drawNetworks(performance.now());
    });
  });

  const drawNetworks = (time: number) => {
    const seconds = time / 1000;

    networkCards.forEach((network) => {
      const { context, width, height, columns, rows, pointer, color } = network;
      if (!width || !height) return;
      context.clearRect(0, 0, width, height);

      const positions = network.nodes.map(({ col, row, phase }) => {
        const baseX = (col / (columns - 1)) * width;
        const baseY = (row / (rows - 1)) * height;
        let x = baseX + Math.sin(seconds * 0.32 + phase) * 1.25;
        let y = baseY + Math.cos(seconds * 0.27 + phase * 0.8) * 1.25;

        if (pointer) {
          const dx = x - pointer.x;
          const dy = y - pointer.y;
          const distance = Math.hypot(dx, dy);
          if (distance < 66 && distance > 0) {
            const shift = (1 - distance / 66) * 2.5;
            x += (dx / distance) * shift;
            y += (dy / distance) * shift;
          }
        }
        return { x, y };
      });

      context.beginPath();
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < columns; col++) {
          const index = row * columns + col;
          const point = positions[index];
          if (col < columns - 1) {
            const right = positions[index + 1];
            context.moveTo(point.x, point.y);
            context.lineTo(right.x, right.y);
          }
          if (row < rows - 1) {
            const below = positions[index + columns];
            context.moveTo(point.x, point.y);
            context.lineTo(below.x, below.y);
          }
          if (row < rows - 1 && col < columns - 1 && (row + col) % 2 === 0) {
            const diagonal = positions[index + columns + 1];
            context.moveTo(point.x, point.y);
            context.lineTo(diagonal.x, diagonal.y);
          }
        }
      }
      context.strokeStyle = color;
      context.globalAlpha = 0.38;
      context.lineWidth = 0.65;
      context.stroke();

      positions.forEach(({ x, y }) => {
        const distance = pointer ? Math.hypot(x - pointer.x, y - pointer.y) : Infinity;
        context.beginPath();
        context.arc(x, y, distance < 66 ? 1.45 : 1, 0, Math.PI * 2);
        context.fillStyle = color;
        context.globalAlpha = distance < 66 ? 0.8 : 0.52;
        context.fill();
      });

      context.globalAlpha = 1;
    });

    if (!reduceMotion) window.requestAnimationFrame(drawNetworks);
  };

  drawNetworks(0);
</script>
