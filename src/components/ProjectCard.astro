---
// Project card. `wide` + the `extra` slot make the flagship variant (incin):
// content on the left, a code snippet pane on the right at lg+.
// `anchor` gives the card a stable id so hero stats can deep-link to it.
import { Icon } from 'astro-icon/components';
import Badge from './Badge.astro';

interface Props {
  name: string;
  description: string;
  tech: string[];
  href: string;
  index: number; // 1-based position, rendered as 01, 02, …
  anchor?: string;
  status?: 'in-progress' | 'team';
  teamCredit?: string;
  impact?: string;
  role?: string;
  wide?: boolean;
}

const { name, description, tech, href, index, anchor, status, teamCredit, impact, role, wide = false } =
  Astro.props;

const pastelAccents = ['#f2b8a2', '#c4b5fd', '#a7e8cf', '#a9d8f5', '#f3b4ce', '#f0d58a'];
const projectAccent = pastelAccents[(index - 1) % pastelAccents.length];
---

<article
  id={anchor}
  style={`--project-accent: ${projectAccent}`}
  class="project-card card-hover group relative flex h-full scroll-mt-24 flex-col overflow-hidden rounded-[var(--radius-card)] border p-md"
>
  <div aria-hidden="true" class="project-card-light pointer-events-none absolute inset-0"></div>
  <canvas aria-hidden="true" class="project-network-canvas pointer-events-none absolute right-0 top-0 h-3/5 w-3/5"></canvas>
  <div aria-hidden="true" class="project-card-stripe pointer-events-none absolute inset-x-0 top-0 h-1"></div>

  <div class:list={['relative z-10 flex h-full flex-col gap-md', wide && 'lg:grid lg:grid-cols-[1fr_minmax(0,340px)] lg:gap-lg']}>
    <div class="flex h-full min-w-0 flex-col gap-md">
      <!-- Header -->
      <div class="flex flex-col gap-xs">
        <div class="flex items-start justify-between gap-sm">
          <h3 class="flex items-baseline gap-sm text-title leading-snug font-semibold text-text">
            <span class="project-number font-mono text-[13px] font-bold">{String(index).padStart(2, '0')}</span>
            {name}
          </h3>
          <div class="flex shrink-0 items-center gap-xs pt-xs">
            {status === 'in-progress' && <Badge label="In Progress" variant="progress" />}
            {status === 'team' && <Badge label="Team" variant="default" />}
          </div>
        </div>
        {role && <p class="project-role w-fit rounded-full px-sm py-0.5 font-mono text-[11px]">{role}</p>}
        {status === 'team' && teamCredit && <p class="text-label text-subtext italic">{teamCredit}</p>}
      </div>

      <!-- Description -->
      <p class="text-body text-text">{description}</p>

      <!-- Impact callout -->
      {impact && (
        <div class="project-impact rounded-r-sm border-l-2 py-xs pl-sm">
          <p class="font-mono text-[12px] font-semibold">{impact}</p>
        </div>
      )}

      <!-- Tech badges -->
      <div class="flex flex-wrap gap-xs">
        {tech.map((item) => (
          <span class="project-tech-tag inline-flex items-center rounded-full px-sm py-xs font-mono text-[12px]">{item}</span>
        ))}
      </div>

      <!-- Project link -->
      <div class="mt-auto flex flex-wrap items-center gap-md pt-xs">
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="project-link inline-flex items-center gap-xs rounded-full px-md py-xs text-label font-semibold text-text transition-colors focus-visible:ring-2 focus-visible:outline-none"
        >
          <Icon name="lucide:github" width={16} height={16} aria-hidden="true" />
          View on GitHub
        </a>
      </div>
    </div>

    {wide && (
      <div class="hidden min-w-0 lg:block">
        <slot name="extra" />
      </div>
    )}
  </div>
</article>

<style>
  .project-card {
    border-color: color-mix(in srgb, var(--project-accent) 15%, var(--color-border));
    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--project-accent) 4%, transparent), transparent 48%),
      var(--color-mantle);
  }

  .project-card-light {
    background: radial-gradient(130px circle at var(--pointer-x, 100%) var(--pointer-y, 0%), color-mix(in srgb, var(--project-accent) 7%, transparent), transparent 100%);
    opacity: 0.7;
    transition: opacity 250ms ease;
  }

  .project-network-canvas {
    opacity: 0.13;
    mask-image: linear-gradient(135deg, transparent 0%, #000 35%, #000 76%, transparent 100%);
    transition: opacity 250ms ease;
  }

  .project-card-stripe {
    background: linear-gradient(90deg, var(--project-accent), color-mix(in srgb, var(--project-accent) 20%, transparent) 75%, transparent);
    opacity: 0.24;
  }

  .project-number {
    color: var(--project-accent);
    text-shadow: 0 0 20px color-mix(in srgb, var(--project-accent) 35%, transparent);
  }

  .project-role,
  .project-tech-tag,
  .project-link {
    border: 1px solid color-mix(in srgb, var(--project-accent) 22%, transparent);
    background: color-mix(in srgb, var(--project-accent) 5%, var(--color-mantle));
  }

  .project-role,
  .project-tech-tag { color: color-mix(in srgb, var(--project-accent) 42%, var(--color-text)); }

  .project-impact {
    border-color: color-mix(in srgb, var(--project-accent) 55%, transparent);
    background: color-mix(in srgb, var(--project-accent) 4%, transparent);
    color: color-mix(in srgb, var(--project-accent) 48%, var(--color-text));
  }

  .project-link:hover {
    border-color: color-mix(in srgb, var(--project-accent) 65%, transparent);
    background: color-mix(in srgb, var(--project-accent) 17%, var(--color-mantle));
    color: var(--project-accent);
  }

  .project-link:focus-visible { --tw-ring-color: var(--project-accent); }

  .project-card:hover { border-color: color-mix(in srgb, var(--project-accent) 30%, var(--color-border)); }
  .project-card:hover .project-network-canvas { opacity: 0.2; }
  .project-card:hover .project-card-light { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .project-network-canvas,
    .project-card-light { transition: none; }
  }
</style>

<script>
  import * as THREE from 'three';

  type ProjectNetwork = {
    canvas: HTMLCanvasElement;
    card: HTMLElement;
    camera: THREE.PerspectiveCamera;
    scene: THREE.Scene;
    renderer: THREE.WebGLRenderer;
    material: THREE.ShaderMaterial;
    mouseX: number;
    mouseY: number;
    targetX: number;
    targetY: number;
    waveActive: boolean;
    waveProgress: number;
  };

  const networks: ProjectNetwork[] = [];
  const gridSize = 7;
  const spacing = 16;
  const offset = (gridSize * spacing) / 2;
  const windowHalfX = window.innerWidth / 2;
  const windowHalfY = window.innerHeight / 2;
  let scrollY = window.scrollY;

  document.querySelectorAll<HTMLCanvasElement>('.project-network-canvas').forEach((canvas) => {
    const card = canvas.closest<HTMLElement>('.project-card');
    if (!card) return;

    const accent = new THREE.Color(getComputedStyle(card).getPropertyValue('--project-accent').trim());
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, 1, 0.1, 1000);
    camera.position.z = 100;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const resize = () => {
      const { width, height } = canvas.getBoundingClientRect();
      if (!width || !height) return;
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
    };
    new ResizeObserver(resize).observe(canvas);
    resize();

    const particleCount = gridSize ** 3;
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(particleCount * 3);
    const baseOpacities = new Float32Array(particleCount);
    let particle = 0;
    for (let x = 0; x < gridSize; x++) {
      for (let y = 0; y < gridSize; y++) {
        for (let z = 0; z < gridSize; z++) {
          positions[particle * 3] = x * spacing - offset + (Math.random() * 1.5 - 0.75);
          positions[particle * 3 + 1] = y * spacing - offset + (Math.random() * 1.5 - 0.75);
          positions[particle * 3 + 2] = z * spacing - offset + (Math.random() * 1.5 - 0.75);
          baseOpacities[particle] = Math.random() * 0.5 + 0.3;
          particle++;
        }
      }
    }
    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('aOpacity', new THREE.BufferAttribute(baseOpacities, 1));

    const material = new THREE.ShaderMaterial({
      uniforms: {
        uWaveCenter: { value: new THREE.Vector3() },
        uWaveRadius: { value: 0 },
        uColorBase: { value: new THREE.Color('#a6adc8') },
        uColorActive: { value: accent },
      },
      vertexShader: `
        uniform vec3 uWaveCenter;
        uniform float uWaveRadius;
        attribute float aOpacity;
        varying float vOpacity;
        varying float vActiveMix;
        void main() {
          float dist = distance(position, uWaveCenter);
          float waveStrength = exp(-pow(dist - uWaveRadius, 2.0) / 150.0);
          vActiveMix = waveStrength;
          vOpacity = aOpacity + (waveStrength * 0.15);
          vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
          gl_PointSize = (1.5 + waveStrength) * (110.0 / -mvPosition.z);
          gl_Position = projectionMatrix * mvPosition;
        }
      `,
      fragmentShader: `
        uniform vec3 uColorBase;
        uniform vec3 uColorActive;
        varying float vOpacity;
        varying float vActiveMix;
        void main() {
          float dist = distance(gl_PointCoord, vec2(0.5));
          if (dist > 0.5) discard;
          float alpha = smoothstep(0.5, 0.3, dist) * vOpacity;
          vec3 finalColor = mix(uColorBase, uColorActive, vActiveMix);
          gl_FragColor = vec4(finalColor, alpha);
        }
      `,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });
    scene.add(new THREE.Points(geometry, material));

    const lineIndices: number[] = [];
    for (let x = 0; x < gridSize; x++) {
      for (let y = 0; y < gridSize; y++) {
        for (let z = 0; z < gridSize; z++) {
          const index = (x * gridSize + y) * gridSize + z;
          if (x + 1 < gridSize) lineIndices.push(index, index + gridSize * gridSize);
          if (y + 1 < gridSize) lineIndices.push(index, index + gridSize);
          if (z + 1 < gridSize) lineIndices.push(index, index + 1);
        }
      }
    }
    const lineGeometry = new THREE.BufferGeometry();
    lineGeometry.setAttribute('position', geometry.getAttribute('position'));
    lineGeometry.setIndex(lineIndices);
    scene.add(new THREE.LineSegments(lineGeometry, new THREE.LineBasicMaterial({
      color: 0x313244,
      transparent: true,
      opacity: 0.25,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    })));

    scene.rotation.x = 0.29;
    scene.rotation.y = -0.385;
    networks.push({ canvas, card, camera, scene, renderer, material, mouseX: 0, mouseY: 0, targetX: 0, targetY: 0, waveActive: false, waveProgress: 0 });
  });

  document.addEventListener('mousemove', (event) => {
    for (const network of networks) {
      network.mouseX = (event.clientX - windowHalfX) * 0.01;
      network.mouseY = (event.clientY - windowHalfY) * 0.01;
    }
  });

  window.addEventListener('scroll', () => { scrollY = window.scrollY; }, { passive: true });

  window.addEventListener('trigger-forward-pass', ((event: CustomEvent<{ x: number; y: number }>) => {
    for (const network of networks) {
      const cardBounds = network.card.getBoundingClientRect();
      if (
        event.detail.x < cardBounds.left || event.detail.x > cardBounds.right ||
        event.detail.y < cardBounds.top || event.detail.y > cardBounds.bottom
      ) continue;

      const bounds = network.canvas.getBoundingClientRect();
      const x = Math.max(0, Math.min(1, (event.detail.x - bounds.left) / bounds.width));
      const y = Math.max(0, Math.min(1, (event.detail.y - bounds.top) / bounds.height));
      const point = new THREE.Vector3(x * 2 - 1, -(y * 2 - 1), 0.5).unproject(network.camera);
      const direction = point.sub(network.camera.position).normalize();
      const distance = -network.camera.position.z / direction.z;
      network.material.uniforms.uWaveCenter.value.copy(network.camera.position.clone().add(direction.multiplyScalar(distance)));
      network.waveActive = true;
      network.waveProgress = 0;
    }
  }) as EventListener);

  function animateNetworks() {
    requestAnimationFrame(animateNetworks);
    const maxScroll = Math.max(1, document.body.scrollHeight - window.innerHeight);
    const scrollFraction = Math.max(0, Math.min(1, scrollY / maxScroll));
    const targetZ = 100 - scrollFraction * 35;

    for (const network of networks) {
      network.targetX = network.mouseX;
      network.targetY = network.mouseY;
      network.camera.position.x += (network.targetX - network.camera.position.x) * 0.05;
      network.camera.position.y += (-network.targetY - network.camera.position.y) * 0.05;
      network.camera.position.z += (targetZ - network.camera.position.z) * 0.05;
      network.camera.lookAt(0, 0, 0);

      if (network.waveActive) {
        network.waveProgress += 2;
        network.material.uniforms.uWaveRadius.value = network.waveProgress;
        if (network.waveProgress > 180) {
          network.waveActive = false;
          network.material.uniforms.uWaveRadius.value = 0;
        }
      }
      network.renderer.render(network.scene, network.camera);
    }
  }

  animateNetworks();
</script>
