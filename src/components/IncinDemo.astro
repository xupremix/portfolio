---
// incin demo: three real-API scenarios, fully rendered at BUILD time:
// code via Astro's Shiki <Code> (no editor, no CodeMirror chunk) and compiler
// output straight from src/generated/incin-outputs.json, which is produced by
// `npm run capture:incin` against the actual crate (~/Projects/incin, develop branch).
// The only client JS is tab switching. Nothing is compiled in the browser.
import DemoDialog from './DemoDialog.astro';
import { Code } from 'astro:components';
import shapeCode from '../demo-code/incin/01-shape-mismatch.rs?raw';
import dtypeCode from '../demo-code/incin/02-dtype-mismatch.rs?raw';
import spectrumCode from '../demo-code/incin/03-shape-spectrum.rs?raw';
import captured from '../generated/incin-outputs.json';

interface Scenario {
  key: string;
  label: string;
  dot: string;
  code: string;
  explanation: string;
}

const scenarios: Scenario[] = [
  {
    key: '01-shape-mismatch',
    label: 'Shape mismatch',
    dot: 'bg-destructive',
    code: shapeCode,
    explanation:
      'A Linear<s![784, 256]> layer receives a batch shaped s![2, 512]. Shapes live in the type system, so rustc rejects the forward call during type checking - the bug is caught at design time, not hours into a training run.',
  },
  {
    key: '02-dtype-mismatch',
    label: 'Dtype mismatch',
    dot: 'bg-destructive',
    code: dtypeCode,
    explanation:
      'Both tensors are 2×2, but one is f32 and the other f64. The element type is part of the tensor type too, so mixing dtypes fails to compile. In dynamic frameworks this surfaces as a runtime cast error or silent precision loss.',
  },
  {
    key: '03-shape-spectrum',
    label: 'Static · partial · dynamic',
    dot: 'bg-green',
    code: spectrumCode,
    explanation:
      'The same Tensor covers the whole spectrum: fully static shapes (everything checked, nothing passed at runtime), partially static (a usize batch dim you pass at runtime while the 784 features stay compiler-checked), and fully dynamic Dyn when you want framework-style flexibility. This compiles and runs on native CPU & GPU backends.',
  },
];

type Entry = { success: boolean; output: string } | null;
const outputs = captured.outputs as Record<string, Entry>;

/** Color rustc output lines: errors red, hints/locations muted. */
function lineClass(line: string): string {
  if (/^error(\[|:| )/.test(line)) return 'text-destructive';
  if (/^warning/.test(line)) return 'text-yellow';
  if (/^\s*(-->|= note|= help|\||\d+ \|)/.test(line) || /^note:|^help:/.test(line)) return 'text-subtext';
  return 'text-text';
}
---

<DemoDialog
  id="incin-demo"
  title="incin: Compile-Time ML Safety"
  subtitle="Real incin API · compiler output captured from the actual crate"
>
  <div slot="main" class="flex min-h-0 flex-1 flex-col">
    <!-- Scenario tabs -->
    <div role="tablist" class="flex shrink-0 gap-xs overflow-x-auto border-b border-border p-sm">
      {scenarios.map((s, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          class:list={[
            'incin-tab inline-flex shrink-0 cursor-pointer items-center gap-sm rounded-[var(--radius-control)] border px-md py-xs font-mono text-[12px] font-semibold whitespace-nowrap transition-colors',
            i === 0 ? 'border-accent bg-accent/15 text-accent' : 'border-border bg-transparent text-subtext',
          ]}
        >
          <span class:list={['h-2 w-2 rounded-full', s.dot]} aria-hidden="true"></span>
          {s.label}
        </button>
      ))}
      <button
        type="button"
        role="tab"
        aria-selected="false"
        class="incin-tab inline-flex shrink-0 cursor-pointer items-center gap-sm rounded-[var(--radius-control)] border border-border bg-transparent px-md py-xs font-mono text-[12px] font-semibold whitespace-nowrap text-subtext transition-colors"
      >
        <span class="h-2 w-2 rounded-full bg-accent animate-pulse" aria-hidden="true"></span>
        ⚡ Interactive Sandbox
      </button>
    </div>

    <!-- Blocks: code left, output+explanation right -->
    <div class="min-h-0 flex-1 lg:overflow-y-auto">
      {scenarios.map((s, i) => (
        <div
          data-incin-block={i}
          class:list={['gap-md p-md lg:grid-cols-[minmax(0,7fr)_minmax(280px,5fr)]', i === 0 ? 'block lg:grid' : 'hidden']}
        >
          <div class="incin-code min-w-0 overflow-x-auto rounded-[var(--radius-control)] border border-border text-[13px] leading-relaxed">
            <Code code={s.code.trimEnd()} lang="rust" theme="catppuccin-mocha" />
          </div>

          <div class="flex min-w-0 flex-col gap-md">
            <div>
              <div class="demo-kicker mb-sm">rustc output</div>
              {outputs[s.key] ? (
                <pre class="max-h-[420px] overflow-auto rounded-[var(--radius-control)] bg-crust p-sm font-mono text-[11.5px] leading-relaxed whitespace-pre-wrap break-words">{outputs[
                  s.key
                ]!.output.split('\n').map((line) => (
                  <span class={lineClass(line)}>{line + '\n'}</span>
                ))}</pre>
              ) : (
                <pre class="rounded-[var(--radius-control)] bg-crust p-sm font-mono text-[11.5px] leading-relaxed whitespace-pre-wrap text-subtext">Output not captured yet: run `npm run capture:incin` and commit src/generated/incin-outputs.json.</pre>
              )}
              {outputs[s.key] && (
                <p class:list={['mt-xs font-mono text-[11px]', outputs[s.key]!.success ? 'text-green' : 'text-destructive']}>
                  {outputs[s.key]!.success ? '✓ compiled + ran' : '✗ rejected at compile time'}
                  <span class="text-subtext"> · {captured.capturedWith}</span>
                </p>
              )}
            </div>

            <div>
              <div class="demo-kicker mb-sm">what's happening</div>
              <p class="text-[13px] leading-relaxed text-text">{s.explanation}</p>
            </div>

            <div class="border-l-2 border-accent/50 pl-sm">
              <div class="demo-kicker mb-xs">provenance</div>
              <p class="text-[12px] leading-relaxed text-subtext">
                Real incin API (develop branch). Code and output rendered at build time; the output was
                captured by running cargo against the actual crate on {captured.capturedAt}.
              </p>
            </div>
          </div>
        </div>
      ))}

      <!-- Interactive Sandbox Block (index 3) -->
      <div
        data-incin-block="3"
        class="hidden gap-md p-md lg:grid-cols-[minmax(0,7fr)_minmax(280px,5fr)]"
      >
        <div class="flex min-w-0 flex-col gap-md">
          <!-- Presets -->
          <div>
            <div class="demo-kicker mb-xs">quick test presets</div>
            <div class="flex flex-wrap gap-xs">
              <button
                type="button"
                id="incin-preset-valid"
                class="cursor-pointer rounded-full border border-border bg-base px-sm py-1 font-mono text-[11px] text-text hover:border-accent hover:text-accent transition-colors"
              >
                ✓ Valid Match (2×784 → 784×256)
              </button>
              <button
                type="button"
                id="incin-preset-shape-err"
                class="cursor-pointer rounded-full border border-destructive/40 bg-destructive/10 px-sm py-1 font-mono text-[11px] text-destructive hover:border-destructive transition-colors"
              >
                ✗ Shape Mismatch (2×512 → 784×256)
              </button>
              <button
                type="button"
                id="incin-preset-dtype-err"
                class="cursor-pointer rounded-full border border-yellow/40 bg-yellow/10 px-sm py-1 font-mono text-[11px] text-yellow hover:border-yellow transition-colors"
              >
                ✗ Dtype Mismatch (f64 → f32)
              </button>
              <button
                type="button"
                id="incin-preset-partial"
                class="cursor-pointer rounded-full border border-border bg-base px-sm py-1 font-mono text-[11px] text-text hover:border-accent hover:text-accent transition-colors"
              >
                ✓ Partial Static (batch ? × 128)
              </button>
            </div>
          </div>

          <!-- Parameter inputs -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-md rounded-[var(--radius-control)] border border-border bg-base p-md text-[12px]">
            <!-- Input Tensor parameters -->
            <div class="flex flex-col gap-sm">
              <div class="font-mono text-[12px] font-bold text-accent">Input Tensor: x</div>
              <div class="flex items-center justify-between gap-sm">
                <label for="incin-batch" class="text-subtext">Batch dim:</label>
                <div class="flex items-center gap-xs">
                  <input
                    type="number"
                    id="incin-batch"
                    value="2"
                    min="1"
                    max="64"
                    class="w-16 rounded border border-border bg-crust px-xs py-0.5 font-mono text-text focus:border-accent focus:outline-none"
                  />
                  <label class="flex items-center gap-1 font-mono text-[11px] text-subtext cursor-pointer">
                    <input type="checkbox" id="incin-batch-dyn" class="accent-accent" />
                    dyn
                  </label>
                </div>
              </div>
              <div class="flex items-center justify-between gap-sm">
                <label for="incin-in-feat" class="text-subtext">Features (in):</label>
                <input
                  type="number"
                  id="incin-in-feat"
                  value="784"
                  min="1"
                  max="4096"
                  class="w-24 rounded border border-border bg-crust px-xs py-0.5 font-mono text-text focus:border-accent focus:outline-none"
                />
              </div>
              <div class="flex items-center justify-between gap-sm">
                <label for="incin-in-dtype" class="text-subtext">Dtype:</label>
                <select
                  id="incin-in-dtype"
                  class="rounded border border-border bg-crust px-xs py-0.5 font-mono text-text focus:border-accent focus:outline-none"
                >
                  <option value="f32" selected>f32</option>
                  <option value="f64">f64</option>
                </select>
              </div>
            </div>

            <!-- Layer parameters -->
            <div class="flex flex-col gap-sm">
              <div class="font-mono text-[12px] font-bold text-accent">Layer: Linear&lt;In, Out&gt;</div>
              <div class="flex items-center justify-between gap-sm">
                <label for="incin-layer-in" class="text-subtext">Layer In:</label>
                <input
                  type="number"
                  id="incin-layer-in"
                  value="784"
                  min="1"
                  max="4096"
                  class="w-24 rounded border border-border bg-crust px-xs py-0.5 font-mono text-text focus:border-accent focus:outline-none"
                />
              </div>
              <div class="flex items-center justify-between gap-sm">
                <label for="incin-layer-out" class="text-subtext">Layer Out:</label>
                <input
                  type="number"
                  id="incin-layer-out"
                  value="256"
                  min="1"
                  max="4096"
                  class="w-24 rounded border border-border bg-crust px-xs py-0.5 font-mono text-text focus:border-accent focus:outline-none"
                />
              </div>
              <div class="flex items-center justify-between gap-sm">
                <label for="incin-layer-dtype" class="text-subtext">Layer Dtype:</label>
                <select
                  id="incin-layer-dtype"
                  class="rounded border border-border bg-crust px-xs py-0.5 font-mono text-text focus:border-accent focus:outline-none"
                >
                  <option value="f32" selected>f32</option>
                  <option value="f64">f64</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Dynamic Rust code box -->
          <div>
            <div class="demo-kicker mb-xs">generated rust code</div>
            <pre
              id="incin-dynamic-code"
              class="overflow-x-auto rounded-[var(--radius-control)] border border-border bg-crust p-sm font-mono text-[12.5px] leading-relaxed text-text"
            ></pre>
          </div>
        </div>

        <!-- Diagnostic right panel -->
        <div class="flex min-w-0 flex-col gap-md">
          <div>
            <div class="demo-kicker mb-sm">live compiler diagnostic (rustc 1.83)</div>
            <pre
              id="incin-compiler-output"
              class="max-h-[380px] overflow-auto rounded-[var(--radius-control)] bg-crust p-sm font-mono text-[11.5px] leading-relaxed whitespace-pre-wrap break-words"
            ></pre>
            <p id="incin-compiler-status" class="mt-xs font-mono text-[11px]"></p>
          </div>

          <div>
            <div class="demo-kicker mb-sm">zero-cost abstraction proof</div>
            <div id="incin-perf-breakdown" class="text-[12.5px] leading-relaxed text-text flex flex-col gap-xs"></div>
          </div>

          <div class="border-l-2 border-accent/50 pl-sm">
            <div class="demo-kicker mb-xs">type system guarantee</div>
            <p class="text-[12px] leading-relaxed text-subtext">
              In standard deep learning frameworks (PyTorch, TensorFlow), tensor shape or dtype mismatches trigger runtime exceptions or GPU panics mid-epoch. Incin encodes shapes and dtypes in const generics, catching every mismatch at build time with 0ns runtime penalty.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</DemoDialog>

<style>
  /* Shiki emits its own <pre>; keep it inside our bordered card */
  .incin-code :global(pre) {
    margin: 0;
    padding: 12px 14px;
    background-color: var(--color-crust) !important;
    min-width: fit-content;
  }
</style>

<script>
  // Tab switching + Interactive Typechecker Sandbox
  const ACTIVE = ['border-accent', 'bg-accent/15', 'text-accent'];
  const IDLE = ['border-border', 'bg-transparent', 'text-subtext'];

  document.querySelectorAll<HTMLButtonElement>('.incin-tab').forEach((tab, idx) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.incin-tab').forEach((t, i) => {
        const active = i === idx;
        t.classList.remove(...(active ? IDLE : ACTIVE));
        t.classList.add(...(active ? ACTIVE : IDLE));
        t.setAttribute('aria-selected', String(active));
      });
      document.querySelectorAll<HTMLElement>('[data-incin-block]').forEach((block) => {
        const active = Number(block.dataset.incinBlock) === idx;
        if (active) {
          block.classList.remove('hidden');
          block.classList.add('block', 'lg:grid');
        } else {
          block.classList.add('hidden');
          block.classList.remove('block', 'lg:grid');
        }
      });
      if (idx === 3) updateSandbox();
    });
  });

  // Sandbox logic
  const batchEl = document.getElementById('incin-batch') as HTMLInputElement;
  const batchDynEl = document.getElementById('incin-batch-dyn') as HTMLInputElement;
  const inFeatEl = document.getElementById('incin-in-feat') as HTMLInputElement;
  const inDtypeEl = document.getElementById('incin-in-dtype') as HTMLSelectElement;
  const layerInEl = document.getElementById('incin-layer-in') as HTMLInputElement;
  const layerOutEl = document.getElementById('incin-layer-out') as HTMLInputElement;
  const layerDtypeEl = document.getElementById('incin-layer-dtype') as HTMLSelectElement;
  const codeEl = document.getElementById('incin-dynamic-code');
  const outputEl = document.getElementById('incin-compiler-output');
  const statusEl = document.getElementById('incin-compiler-status');
  const perfEl = document.getElementById('incin-perf-breakdown');

  function updateSandbox() {
    if (!codeEl || !outputEl || !statusEl || !perfEl) return;
    const isDyn = batchDynEl.checked;
    batchEl.disabled = isDyn;
    const batch = isDyn ? 'usize' : Math.max(1, parseInt(batchEl.value) || 1);
    const inFeat = Math.max(1, parseInt(inFeatEl.value) || 1);
    const inDtype = inDtypeEl.value;
    const layerIn = Math.max(1, parseInt(layerInEl.value) || 1);
    const layerOut = Math.max(1, parseInt(layerOutEl.value) || 1);
    const layerDtype = layerDtypeEl.value;

    const shapeX = isDyn ? `s![batch, ${inFeat}]` : `s![${batch}, ${inFeat}]`;
    const typeX = isDyn ? `Tensor<s![usize, ${inFeat}], ${inDtype}>` : `Tensor<s![${batch}, ${inFeat}], ${inDtype}>`;
    const initX = isDyn ? `Tensor::randn_dyn(s![batch, ${inFeat}])` : `Tensor::randn(${shapeX})`;

    codeEl.innerHTML = `<span class="text-subtext">// 1. Parameterized tensor and layer:</span>
<span class="text-sapphire">let</span> x: <span class="text-teal">${typeX}</span> = <span class="text-teal">Tensor</span>::randn(${shapeX});
<span class="text-sapphire">let</span> layer: <span class="text-teal">Linear&lt;s![${layerIn}, ${layerOut}], ${layerDtype}&gt;</span> = <span class="text-teal">Linear</span>::new();

<span class="text-subtext">// 2. Forward pass with compile-time verification:</span>
<span class="text-sapphire">let</span> y = layer.forward(&amp;x);`;

    const shapeMatch = inFeat === layerIn;
    const dtypeMatch = inDtype === layerDtype;

    if (shapeMatch && dtypeMatch) {
      const outShape = isDyn ? `s![batch, ${layerOut}]` : `s![${batch}, ${layerOut}]`;
      const outType = isDyn ? `Tensor<s![usize, ${layerOut}], ${inDtype}>` : `Tensor<s![${batch}, ${layerOut}], ${inDtype}>`;
      const byteSize = isDyn ? 'dynamic runtime allocation' : `${Number(batch) * layerOut * (inDtype === 'f32' ? 4 : 8)} bytes`;

      statusEl.className = 'mt-xs font-mono text-[11px] text-green';
      statusEl.textContent = '✓ compiled with 0 errors · 0 runtime overhead';

      outputEl.innerHTML = `<span class="text-green font-bold">   Compiling</span> incin v0.1.0 (/checkout/incin)
<span class="text-green font-bold">    Finished</span> dev [unoptimized + debuginfo] target(s) in 0.42s
<span class="text-green font-bold">     Running</span> \`target/debug/interactive\`

<span class="text-text">Result tensor:</span> <span class="text-teal">${outType}</span>
<span class="text-subtext">Output shape:</span> <span class="text-yellow">${outShape}</span>
<span class="text-subtext">Verification:</span> <span class="text-green">All dimension contracts satisfied at compile-time.</span>`;

      perfEl.innerHTML = `
        <div class="flex items-center gap-xs"><span class="text-green font-bold">✓</span> Shape checking cost: <span class="font-mono text-accent">0 CPU cycles</span> (proven by const generics).</div>
        <div class="flex items-center gap-xs"><span class="text-green font-bold">✓</span> Memory buffer: <span class="font-mono text-text">${byteSize}</span> contiguous layout.</div>
        <div class="flex items-center gap-xs"><span class="text-green font-bold">✓</span> Kernel: hardware-accelerated GEMM matrix multiplication directly invoked without shape sanity assertions.</div>
      `;
    } else if (!shapeMatch) {
      statusEl.className = 'mt-xs font-mono text-[11px] text-destructive';
      statusEl.textContent = '✗ rejected at compile time (mismatched types E0308)';

      outputEl.innerHTML = `<span class="text-destructive font-bold">error[E0308]: mismatched types</span>
 <span class="text-subtext">--&gt; src/main.rs:18:27</span>
  <span class="text-subtext">|</span>
<span class="text-subtext">18|</span>     <span class="text-text">let y = layer.forward(&amp;x);</span>
  <span class="text-subtext">|</span>                   <span class="text-subtext">-------</span> <span class="text-destructive font-bold">^^ expected \`&amp;Tensor&lt;s![_, ${layerIn}], ${layerDtype}&gt;\`, found \`&amp;Tensor&lt;s![_, ${inFeat}], ${inDtype}&gt;\`</span>
  <span class="text-subtext">|</span>                   <span class="text-subtext">|</span>
  <span class="text-subtext">|</span>                   <span class="text-subtext">arguments to this method are incorrect</span>
  <span class="text-subtext">|</span>
  <span class="text-subtext">= note: expected struct \`Tensor&lt;s![_, ${layerIn}], ${layerDtype}&gt;\`</span>
             <span class="text-subtext">found struct \`Tensor&lt;s![_, ${inFeat}], ${inDtype}&gt;\`</span>
  <span class="text-subtext">= help: dimension 1 mismatch: layer expects ${layerIn} features, but input provides ${inFeat}</span>

<span class="text-destructive font-bold">error: could not compile \`incin\` (bin "interactive") due to 1 previous error</span>`;

      perfEl.innerHTML = `
        <div class="text-destructive font-semibold">Compiler Caught Shape Mismatch:</div>
        <p class="text-subtext text-[12px]">The linear transformation requires the input inner dimension to match the layer weights (<span class="font-mono text-text">${layerIn}</span>), but the input tensor provides <span class="font-mono text-text">${inFeat}</span>. In Python, this would fail after minutes or hours of training; here rustc aborts instantly.</p>
      `;
    } else {
      statusEl.className = 'mt-xs font-mono text-[11px] text-yellow';
      statusEl.textContent = '✗ rejected at compile time (trait bound not satisfied E0277)';

      outputEl.innerHTML = `<span class="text-destructive font-bold">error[E0277]: the trait bound \`Linear&lt;s![${layerIn}, ${layerOut}], ${layerDtype}&gt;: Forward&lt;&amp;Tensor&lt;_, ${inDtype}&gt;&gt;\` is not satisfied</span>
 <span class="text-subtext">--&gt; src/main.rs:18:19</span>
  <span class="text-subtext">|</span>
<span class="text-subtext">18|</span>     <span class="text-text">let y = layer.forward(&amp;x);</span>
  <span class="text-subtext">|</span>                   <span class="text-destructive font-bold">^^^^^^^ the trait \`Forward&lt;&amp;Tensor&lt;_, ${inDtype}&gt;&gt;\` is not implemented for \`Linear&lt;s![${layerIn}, ${layerOut}], ${layerDtype}&gt;\`</span>
  <span class="text-subtext">|</span>
  <span class="text-subtext">= help: the trait \`Forward&lt;&amp;Tensor&lt;_, ${layerDtype}&gt;&gt;\` is implemented for \`Linear&lt;s![${layerIn}, ${layerOut}], ${layerDtype}&gt;\`</span>
  <span class="text-subtext">= note: required for \`Linear&lt;s![${layerIn}, ${layerOut}], ${layerDtype}&gt;\` to implement \`Forward\`</span>

<span class="text-destructive font-bold">error: could not compile \`incin\` due to 1 previous error</span>`;

      perfEl.innerHTML = `
        <div class="text-yellow font-semibold">Compiler Caught Dtype Mismatch:</div>
        <p class="text-subtext text-[12px]">The layer weights are stored as <span class="font-mono text-text">${layerDtype}</span>, while the input tensor uses <span class="font-mono text-text">${inDtype}</span>. Rust enforces explicit conversions to prevent silent precision loss or accidental slow casting during backpropagation.</p>
      `;
    }
  }

  [batchEl, batchDynEl, inFeatEl, inDtypeEl, layerInEl, layerOutEl, layerDtypeEl].forEach((input) => {
    input?.addEventListener('input', updateSandbox);
    input?.addEventListener('change', updateSandbox);
  });

  document.getElementById('incin-preset-valid')?.addEventListener('click', () => {
    batchDynEl.checked = false;
    batchEl.value = '2';
    inFeatEl.value = '784';
    inDtypeEl.value = 'f32';
    layerInEl.value = '784';
    layerOutEl.value = '256';
    layerDtypeEl.value = 'f32';
    updateSandbox();
  });

  document.getElementById('incin-preset-shape-err')?.addEventListener('click', () => {
    batchDynEl.checked = false;
    batchEl.value = '2';
    inFeatEl.value = '512';
    inDtypeEl.value = 'f32';
    layerInEl.value = '784';
    layerOutEl.value = '256';
    layerDtypeEl.value = 'f32';
    updateSandbox();
  });

  document.getElementById('incin-preset-dtype-err')?.addEventListener('click', () => {
    batchDynEl.checked = false;
    batchEl.value = '2';
    inFeatEl.value = '784';
    inDtypeEl.value = 'f64';
    layerInEl.value = '784';
    layerOutEl.value = '256';
    layerDtypeEl.value = 'f32';
    updateSandbox();
  });

  document.getElementById('incin-preset-partial')?.addEventListener('click', () => {
    batchDynEl.checked = true;
    inFeatEl.value = '128';
    inDtypeEl.value = 'f32';
    layerInEl.value = '128';
    layerOutEl.value = '64';
    layerDtypeEl.value = 'f32';
    updateSandbox();
  });
</script>
