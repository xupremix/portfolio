---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <main class="flex flex-col items-center justify-center text-center gap-md py-3xl">
    <h1 class="text-display font-semibold">Page not found</h1>
    <p class="text-body text-subtext">That page doesn't exist. Head back to the homepage.</p>
    <a
      href="/"
      class="text-accent hover:underline focus-visible:ring-2 focus-visible:ring-accent/60"
    >
      Back to homepage
    </a>
  </main>
</Layout>
